// Chronicle rules: a story, a scene played day by day
// --------------------------------------------------
// The functions of expedition.pg that play a story (storytable.pg's `walkStories`): a walk of
// days with no zone, played once, never kept as a record. Imported by expedition.pg after
// encounterlib.pg, ahead of the tables: a function is a constant of the script that declares it
// and its index must fit in a byte, and expeditionlib.pg is full.
//
// They read and write expedition.pg's globals by name, as expeditionlib.pg's do (`run`, `record`,
// `marks`, `fight`, `foes`, `account`, `after`, `entries`, `errors`), and use its functions
// (`pick`, `runOf`, `mine`, `openStep`, `give`, `shiftHp`...).
//
// The run of a story, flat as every run is:
//   {story, zone: "", mode (site | done), day (the day he is on, from 1), days, months,
//    monthsRun (the months gone by), monthsDue (the months the act just answered has run: the
//    Life screen runs them), ap (the days left: a day is one, so openStep and stayOver hold),
//    apTotal, spent, hp, hpMax, hpStart, found: "", event ("" or "story.<id>": a card, a test or
//    a chance meeting of the story waits for his answer), refused, leaving, result ("" while it
//    runs, then "over", "left", "dropout" or the grade's id), seed, startMonth,
//    "m.<mark>" (a mark of the scene), "t.<tile>" (the times a tile was taken),
//    "c.<card>" (a card answered), "met.<event>" (a chance meeting met),
//    "sat.<test>" and "score.<test>" (a test sat, and what it scored)}
// A step of the record is a day: kind "tile", target the tile's id. A mark is also written to
// `marks` ({step, kind: "mark", id, n}), a stat it gave ({kind: "stat"}) and a fee ({kind: "fee"}),
// so the page says what the scene has given and taken. An answer is a step too: kind "card",
// "event" (no day) or "test" (its day), target "<card>/<answer>".

import "string"
import "math"
import "algorithm"

// ---- the tables ------------------------------------------------------------------------------------------

fun storyOf(id)
{
    for (var i = 0; i < len(walkStories); i++)
    {
        if (walkStories[i].id == id)
        {
            return walkStories[i]
        }
    }

    return {id: ""}
}

fun storyTile(story, id)
{
    var tiles = pick(story, "tiles", [])

    for (var i = 0; i < len(tiles); i++)
    {
        if (tiles[i].id == id)
        {
            return tiles[i]
        }
    }

    return {id: ""}
}

// The story being played
fun storyNow()
{
    return storyOf(pick(run, "story", ""))
}

// ---- the marks of the scene, and what holds ---------------------------------------------------------------

fun markOf(key)
{
    return runOf("m." + key)
}

fun addMark(key, n)
{
    run["m." + key] = markOf(key) + n

    if (len(record) > 0)
    {
        push(marks, {step: len(record), kind: "mark", id: key, n: n})
    }
}

// The times a tile was taken in this scene
fun takenOf(id)
{
    return runOf("t." + id)
}

// A mark of the scene, a tile taken ("tile.<id>") or a stat or flag of his life
fun holds(key)
{
    if (startsWith(key, "tile."))
    {
        return takenOf(substring(key, 5)) > 0
    }

    return markOf(key) > 0 or mine(key) > 0
}

// The name the page gives a mark: the story's, or its id
fun markName(story, key)
{
    var named = pick(story, "marks", [])

    for (var i = 0; i < len(named); i++)
    {
        if (named[i].id == key)
        {
            return named[i].name
        }
    }

    return capitalised(key)
}

// What a tile asks that he has not: its first need not met, in words ("" when all are)
fun needShort(tile)
{
    var needs = pick(tile, "needs", [])

    for (var i = 0; i < len(needs); i++)
    {
        var need = needs[i]
        var mark = pick(need, "mark", "")
        var has = 0
        var name = ""

        if (mark != "")
        {
            has = markOf(mark)
            name = toUpperCase(markName(storyNow(), mark))
        }
        else
        {
            has = mine(pick(need, "stat", ""))
            name = toUpperCase(statName(pick(need, "stat", "")))
        }

        if (has < pick(need, "at", 1))
        {
            return pick(need, "asks", "ASKS MORE " + name)
        }
    }

    return ""
}

// What a tile costs in coin and such, in words: "1 coin", "" when free
fun feeText(tile)
{
    var fee = pick(tile, "fee", [])
    var parts = []

    for (var i = 0; i < len(fee); i++)
    {
        push(parts, toString(fee[i].amount) + " " + toLowerCase(statName(fee[i].stat)))
    }

    return joined(parts, ", ")
}

// Whether a tile is shown today: within its days, nothing it shuts on holds, not taken its most
fun tileOffered(tile)
{
    var day = runOf("day")
    var days = pick(tile, "days", [1, runOf("days")])

    if (day < days[0] or day > days[1])
    {
        return false
    }

    var shut = pick(tile, "not", [])

    for (var i = 0; i < len(shut); i++)
    {
        if (holds(shut[i]))
        {
            return false
        }
    }

    var most = pick(tile, "most", 0)

    if (most > 0 and takenOf(tile.id) >= most)
    {
        return false
    }

    return true
}

// Why a tile shown cannot be taken: what it needs, what it costs, the days it takes ("" if it can)
fun tileShort(tile)
{
    var need = needShort(tile)

    if (need != "")
    {
        return need
    }

    var fee = pick(tile, "fee", [])

    for (var i = 0; i < len(fee); i++)
    {
        if (mine(fee[i].stat) < fee[i].amount)
        {
            return "ASKS " + toUpperCase(feeText(tile)) + ", " + toString(mine(fee[i].stat)) + " HELD"
        }
    }

    if (pick(tile, "cost", 1) > runOf("ap"))
    {
        return "NOT ENOUGH DAYS LEFT"
    }

    return ""
}

// ---- the days -------------------------------------------------------------------------------------------

// A story begins: its first day, the days before him
fun enterStory(id)
{
    var story = storyOf(id)

    if (story.id == "")
    {
        push(errors, "unknown story " + id)
        return
    }

    run = {story: story.id, zone: "", mode: "site", day: 1, days: story.days, months: story.months, monthsRun: 0, monthsDue: 0,
           ap: story.days, apTotal: story.days, spent: 0,
           hp: fieldHp(), hpMax: mostOf(after, "vit"), hpStart: fieldHp(),
           found: "", event: "", refused: "", leaving: 0, result: "", seed: diceFrom(seed), startMonth: monthOf(age)}

    record = []
    marks = []
    fight = {over: "", mob: ""}
    foes = []
    account = []

    noteOffer()

    // A card of the first day is there when he arrives
    openDue()
}

// What is offered, noted when a day begins (a look writes nothing, so what the page says of
// the day is kept in the run): "seen.<tile>" the day a tile was first listed, "off.<tile>" 1
// while it was listed at the last note, "gone.<tile>" the day it left. A tile just taken that
// left by itself (not by its `most`) is not said gone
fun noteOffer()
{
    var tiles = pick(storyNow(), "tiles", [])
    var day = runOf("day")
    var took = pick(run, "took", "")

    for (var i = 0; i < len(tiles); i++)
    {
        var tile = tiles[i]
        var key = tile.id

        if (tileOffered(tile))
        {
            if (pick(run, "seen." + key, 0) == 0)
            {
                run["seen." + key] = day
            }

            run["off." + key] = 1
        }
        else
        {
            var most = pick(tile, "most", 0)
            var byMost = most > 0 and takenOf(key) >= most

            if (pick(run, "off." + key, 0) == 1 and (took != key or byMost))
            {
                run["gone." + key] = day
            }

            run["off." + key] = 0
        }
    }

    run.took = ""
}

// The tiles that left since yesterday, for the day only: {id, name}
fun goneRows()
{
    var tiles = pick(storyNow(), "tiles", [])
    var rows = []

    if (run.mode == "done")
    {
        return rows
    }

    for (var i = 0; i < len(tiles); i++)
    {
        if (pick(run, "gone." + tiles[i].id, 0) == runOf("day") and not tileOffered(tiles[i]))
        {
            push(rows, {id: "tile." + tiles[i].id, name: tiles[i].name})
        }
    }

    return rows
}

// What he would score if the tests were sat today, the tests sat counted as they scored: the best
// answer open to him for each. Never said; only the words it picks are
fun standingEstimate(story)
{
    var tests = pick(story, "tests", [])
    var total = 0

    for (var i = 0; i < len(tests); i++)
    {
        var test = tests[i]

        if (pick(run, "sat." + test.id, 0) > 0)
        {
            total = total + pick(run, "score." + test.id, 0)
            continue
        }

        if (pick(test, "kind", "card") == "fight")
        {
            total = total + markOf("practised") * pick(test, "practised", 0)
            continue
        }

        var options = pick(test, "options", [])
        var best = testScore(test, {})

        for (var j = 0; j < len(options); j++)
        {
            var open = true
            var needs = pick(options[j], "needs", [])

            for (var k = 0; k < len(needs); k++)
            {
                if (not meets(needs[k]))
                {
                    open = false
                }
            }

            if (open)
            {
                best = larger(best, testScore(test, options[j]))
            }
        }

        total = total + best
    }

    return total
}

// How he stands, in words: the line of the story's `standing` the estimate has reached ("" when
// the story says none)
fun standingLine(story)
{
    var lines = pick(story, "standing", [])
    var line = ""
    var estimate = standingEstimate(story)

    for (var i = 0; i < len(lines); i++)
    {
        if (estimate >= lines[i].at)
        {
            line = lines[i].line
        }
    }

    return line
}

// The months that fall due as the days pass: the row's months spread over the scene's days,
// counted from the day he is on, less those gone by already
fun monthsDue()
{
    return wholeOf((runOf("day") - 1) * runOf("months"), larger(1, runOf("days"))) - runOf("monthsRun")
}

// The day's end: the next day comes, and the months it completes are run (by the Life screen).
// The new day begins with its card, if one waits, or by chance a meeting of the story's
fun endDay(days)
{
    run.day = runOf("day") + days

    var due = monthsDue()

    run.monthsDue = due
    run.monthsRun = runOf("monthsRun") + due

    if (runOf("day") <= runOf("days"))
    {
        noteOffer()
        openDue()

        if (run.event == "")
        {
            maybeEvent("day")
        }
    }
}

// What a gift brings, in words, for the tile's gloss and the record ("" for a mark: the scene's
// own count is not said in figures)
fun giftText(gift)
{
    if (typeOf(gift.stat) != "none")
    {
        return "+" + toString(gift.amount) + " " + statName(gift.stat)
    }

    if (typeOf(gift.item) != "none")
    {
        return itemText(gift.item, gift.amount)
    }

    if (typeOf(gift.hp) != "none")
    {
        return "+" + toString(gift.hp) + " Vitality"
    }

    if (typeOf(gift.fight) != "none")
    {
        var mob = mobOf(gift.fight)

        return "A bout with " + theName(toLowerCase(foundName(mob, pick(gift, "count", 1))))
    }

    return ""
}

// What a tile gives, in words: the stats and things with their figures, the marks by their names
fun givesText(story, tile)
{
    var gives = pick(tile, "gives", [])
    var parts = []

    for (var i = 0; i < len(gives); i++)
    {
        if (typeOf(gives[i].mark) != "none")
        {
            push(parts, markName(story, gives[i].mark))
        }
        else
        {
            var text = giftText(gives[i])

            if (text != "")
            {
                push(parts, text)
            }
        }
    }

    if (len(parts) == 0)
    {
        return "The day, and what he makes of it"
    }

    return joined(parts, ", ")
}

// A gift of a tile, as it lands: a mark of the scene, a stat on him, a thing in the bag, his
// Vitality, a fight (on its own at once, else on the fight screen: `storyFight`)
fun giveGift(gift)
{
    if (typeOf(gift.mark) != "none")
    {
        addMark(gift.mark, gift.amount)
    }
    else if (typeOf(gift.stat) != "none")
    {
        after[gift.stat] = mine(gift.stat) + gift.amount
        push(marks, {step: len(record), kind: "stat", id: gift.stat, n: gift.amount})
    }
    else if (typeOf(gift.item) != "none")
    {
        give(gift.item, gift.amount)
    }
    else if (typeOf(gift.hp) != "none")
    {
        shiftHp(gift.hp)
    }
    else if (typeOf(gift.fight) != "none")
    {
        var mob = mobOf(gift.fight)

        run.fightFrom = pick(run, "giving", "")
        storyFight(gift.fight, pick(gift, "count", 1), pick(gift, "turns", pick(mob, "turns", 0)))

        if (pick(gift, "auto", false) and pick(run, "found", "") != "")
        {
            fightOnItsOwn()
            storyFightBack(true)
        }
    }
}

// A tile taken: its fee paid, its gifts given, its days gone
fun takeTile(id)
{
    var story = storyNow()
    var tile = storyTile(story, id)

    if (tile.id == "" or not tileOffered(tile))
    {
        run.refused = "That is not offered today"
        return
    }

    var short = tileShort(tile)

    if (short != "")
    {
        run.refused = capitalised(toLowerCase(short))
        return
    }

    var cost = pick(tile, "cost", 1)

    openStep("tile", tile.id, 1, cost, pick(tile, "line", tile.name), pick(tile, "glyph", story.glyph))

    // (its own line: a fight it gives writes another after it)
    var step = lastStep()
    var fee = pick(tile, "fee", [])

    for (var i = 0; i < len(fee); i++)
    {
        after[fee[i].stat] = mine(fee[i].stat) - fee[i].amount
        push(marks, {step: len(record), kind: "fee", id: fee[i].stat, n: fee[i].amount})
    }

    run["t." + tile.id] = takenOf(tile.id) + 1
    run.took = tile.id

    var gives = pick(tile, "gives", [])
    var gave = []

    run.giving = "tile." + tile.id

    for (var i = 0; i < len(gives); i++)
    {
        giveGift(gives[i])

        // (a fight is told in its own line)
        var text = giftText(gives[i])

        if (text != "" and typeOf(gives[i].fight) == "none")
        {
            push(gave, text)
        }
    }

    run.giving = ""

    // The line's right: the days, what it cost him, what it gave (a mark is not said in figures)
    var parts = [toUpperCase(counted(cost, story.unit, story.unit + "s"))]

    if (feeText(tile) != "")
    {
        step.used = "−" + feeText(tile)
        push(parts, toUpperCase(step.used))
    }

    if (len(gave) > 0)
    {
        step.gave = joined(gave, ", ")
        push(parts, toUpperCase(step.gave))
    }

    step.figure = joined(parts, " · ")

    // A fight on the fight screen: the day ends when he is back from it
    if (pick(run, "found", "") != "")
    {
        run.fightDays = cost
        return
    }

    endDay(cost)
}

// Leave is asked twice: the first press says what is lost, the second ends the scene as it stands
fun leaveStory()
{
    if (runOf("leaving") == 0 and runOf("ap") > 0)
    {
        run.leaving = 1
        return
    }

    var lost = runOf("ap")

    openStep("leave", "", 1, 0, "Left on the " + storyDayText() + ", " + daysText(lost) + " unspent", "gate")

    var step = lastStep()
    step.figure = "LEFT"

    run.ap = 0
    run.left = lost
    run.result = "left"

    // Leaving a class is dropping out of it
    dropOut()
}

// One thing he does in a story: a tile (`tile` and its id, or `tile.<id>` as the page sends it)
// or leave
fun storyAct(kind, target)
{
    if (kind == "leave")
    {
        leaveStory()
    }
    else if (kind == "tile")
    {
        takeTile(target)
    }
    else if (startsWith(kind, "tile."))
    {
        takeTile(substring(kind, 5))
    }
    else
    {
        run.refused = "That is not done here"
    }
}

// The scene is over: its last day gone, or he left. No record is kept and no place is walked:
// what it gave is his, what it took stays taken
fun endStory()
{
    var story = storyNow()

    run.mode = "done"
    run.leaving = 0

    if (pick(run, "result", "") == "")
    {
        run.result = "over"
    }

    // "The trial" in the middle of a line is "the trial"
    var name = story.name

    if (startsWith(name, "The "))
    {
        name = "the " + substring(name, 4, strlen(name))
    }

    if (run.result == "left")
    {
        push(entries, {text: "Left " + name + " on the " + storyDayText() + ", with what it had given him", kind: "note", figure: "", glyph: story.glyph})
    }
    else if (run.result == "dropout")
    {
        push(entries, {text: "Dropped out of " + name + " on the " + storyDayText() + ", with what it had given him", kind: "loss", figure: "", glyph: story.glyph})
    }
    else if (run.result == "over")
    {
        push(entries, {text: "Saw " + name + " to its end", kind: "note", figure: "", glyph: story.glyph})
    }

    // A grade wrote its own line (storyResult)
}

// ---- the cards, the chance meetings and the tests -----------------------------------------------------
//
// A card, a test or a meeting of the story is up while `run.event` is "story.<its id>": the walk's
// event screen shows it (expeditionlib.pg's `eventCard` and `optionRows` ask `storyCardPage` and
// `storyOptionRows`) and the answer comes to `storyChoose`. A card is no day: the day's tiles are
// there again once it is answered. A test is its day's work.

fun storyCard(story, id)
{
    var cards = pick(story, "cards", [])

    for (var i = 0; i < len(cards); i++)
    {
        if (cards[i].id == id)
        {
            return cards[i]
        }
    }

    return {id: ""}
}

fun storyTest(story, id)
{
    var tests = pick(story, "tests", [])

    for (var i = 0; i < len(tests); i++)
    {
        if (tests[i].id == id)
        {
            return tests[i]
        }
    }

    return {id: ""}
}

fun storyEvent(story, id)
{
    var events = pick(story, "events", [])

    for (var i = 0; i < len(events); i++)
    {
        if (events[i].id == id)
        {
            return events[i]
        }
    }

    return {id: ""}
}

// What is up, by the id `run.event` gives it ("story.<id>"): the card, the test or the meeting
fun storyUp()
{
    if (not startsWith(pick(run, "event", ""), "story."))
    {
        return {id: ""}
    }

    var id = substring(run.event, 6)
    var story = storyNow()
    var test = storyTest(story, id)

    if (test.id != "")
    {
        return test
    }

    var card = storyCard(story, id)

    if (card.id != "")
    {
        return card
    }

    return storyEvent(story, id)
}

// What is up: "test", "card", "event", or "" (each looked up into a var: a field of a table a
// function has just built is not read off the call)
fun upKind()
{
    var up = storyUp()

    if (up.id == "")
    {
        return ""
    }

    var story = storyNow()
    var test = storyTest(story, up.id)

    if (test.id != "")
    {
        return "test"
    }

    var card = storyCard(story, up.id)

    if (card.id != "")
    {
        return "card"
    }

    return "event"
}

// A condition of a card or a need: a mark of the scene, or a stat or flag of his life, at `at`
// or more (1 when it says none)
fun meets(cond)
{
    var at = pick(cond, "at", 1)

    if (typeOf(cond.mark) != "none")
    {
        return markOf(cond.mark) >= at
    }

    if (typeOf(cond.flag) != "none")
    {
        return mine(cond.flag) >= at
    }

    return mine(pick(cond, "stat", "")) >= at
}

fun answered(id)
{
    return runOf("c." + id) > 0
}

// The curriculum: the marks of its courses together come to its least (no gate: it holds)
fun gateHolds(story)
{
    var gate = pick(story, "gate", {})
    var courses = pick(gate, "courses", [])
    var followed = 0

    for (var i = 0; i < len(courses); i++)
    {
        followed = followed + markOf(courses[i])
    }

    return followed >= pick(gate, "least", 0)
}

// The card that waits for him today, "" when none: first a card whose `when` is met, then the
// card of the day, then, from the gate's day, the masters sending him away if the curriculum is
// not followed (and no test opens), then the tests in their days' order. Each card opens once,
// each test is sat once
fun dueCard()
{
    var story = storyNow()
    var day = runOf("day")
    var cards = pick(story, "cards", [])
    var gate = pick(story, "gate", {})
    var gateCard = pick(gate, "card", "")

    for (var i = 0; i < len(cards); i++)
    {
        var card = cards[i]

        if (card.id != gateCard and pick(card, "day", 0) == 0 and not answered(card.id))
        {
            var when = pick(card, "when", [])
            var met = true

            for (var w = 0; w < len(when); w++)
            {
                if (not meets(when[w]))
                {
                    met = false
                }
            }

            if (met)
            {
                return card.id
            }
        }
    }

    // (a card whose day went by inside a tile of several days comes the day he is out of it)
    for (var i = 0; i < len(cards); i++)
    {
        var on = pick(cards[i], "day", 0)

        if (cards[i].id != gateCard and on > 0 and on <= day and not answered(cards[i].id))
        {
            return cards[i].id
        }
    }

    if (typeOf(story.gate) != "none" and day >= pick(gate, "day", 0) and not gateHolds(story))
    {
        if (gateCard != "" and not answered(gateCard))
        {
            return gateCard
        }

        return ""
    }

    var tests = pick(story, "tests", [])

    for (var i = 0; i < len(tests); i++)
    {
        if (pick(tests[i], "day", 0) <= day and runOf("sat." + tests[i].id) == 0)
        {
            return tests[i].id
        }
    }

    return ""
}

// The card that waits, put up (nothing once the scene is over)
fun openDue()
{
    if (run.mode == "done" or pick(run, "result", "") != "" or runOf("day") > runOf("days") or pick(run, "found", "") != "")
    {
        return
    }

    var id = dueCard()

    if (id != "")
    {
        run.event = "story." + id
    }
}

// A chance meeting of the story's own, in place of a zone's (expeditionlib.pg's `maybeEvent`
// asks it in a story): one of those of the trigger and the day, not met yet in the scene
fun drawStoryEvent(trigger)
{
    if (pick(run, "event", "") != "")
    {
        return
    }

    var story = storyNow()
    var events = pick(story, "events", [])
    var day = runOf("day")
    var open = []
    var weight = 0

    for (var i = 0; i < len(events); i++)
    {
        var event = events[i]
        var days = pick(event, "days", [1, runOf("days")])

        if (event.trigger == trigger and day >= days[0] and day <= days[1] and runOf("met." + event.id) == 0)
        {
            if (not pick(event, "once", false) or mine("met." + story.id + "." + event.id) <= 0)
            {
                push(open, event)
                weight = weight + pick(event, "weight", 1)
            }
        }
    }

    if (len(open) == 0 or not chance(walkKnobs.eventChance))
    {
        return
    }

    var drawn = roll(weight)

    for (var i = 0; i < len(open); i++)
    {
        var w = pick(open[i], "weight", 1)

        if (drawn >= 0 and drawn < w)
        {
            run.event = "story." + open[i].id
        }

        drawn = drawn - w
    }
}

// Whether an answer is listed: nothing it shuts on holds, and a test's answer is there only for
// who holds what it needs (a card's is shown shut, saying what it asks)
fun answerShown(option, isTest)
{
    var shut = pick(option, "not", [])

    for (var i = 0; i < len(shut); i++)
    {
        if (holds(shut[i]))
        {
            return false
        }
    }

    return not isTest or needShort(option) == ""
}

// Why an answer listed cannot be given: what it needs, what it costs ("" if it can)
fun answerShort(option)
{
    var need = needShort(option)

    if (need != "")
    {
        return need
    }

    var fee = pick(option, "fee", [])

    for (var i = 0; i < len(fee); i++)
    {
        if (mine(fee[i].stat) < fee[i].amount)
        {
            return "ASKS " + toUpperCase(feeText(option)) + ", " + toString(mine(fee[i].stat)) + " HELD"
        }
    }

    return ""
}

// An answer in one line: what it costs and gives, and for a test what it leans on (never how
// much: no figure of the score is said)
fun answerLine(option, isTest)
{
    var story = storyNow()
    var parts = []
    var ap = pick(option, "ap", 0)

    if (ap > 0)
    {
        push(parts, counted(ap, story.unit, story.unit + "s"))
    }

    if (feeText(option) != "")
    {
        push(parts, "−" + feeText(option))
    }

    var hp = pick(option, "hp", 0)

    if (hp != 0)
    {
        push(parts, signed(hp) + " vitality")
    }

    var items = pick(option, "items", [])

    for (var i = 0; i < len(items); i++)
    {
        if (items[i].amount < 0)
        {
            push(parts, "−" + itemText(items[i].id, 0 - items[i].amount))
        }
        else
        {
            push(parts, "+" + itemText(items[i].id, items[i].amount))
        }
    }

    var effects = pick(option, "effects", [])

    for (var i = 0; i < len(effects); i++)
    {
        if (effects[i].kind == "stat")
        {
            push(parts, signed(effects[i].amount) + " " + toLowerCase(statName(effects[i].stat)))
        }
    }

    var gives = pick(option, "gives", [])

    for (var i = 0; i < len(gives); i++)
    {
        if (typeOf(gives[i].mark) != "none")
        {
            push(parts, markName(story, gives[i].mark))
        }
        else if (giftText(gives[i]) != "")
        {
            push(parts, giftText(gives[i]))
        }
    }

    if (isTest)
    {
        var swap = pick(option, "swap", {})
        var adds = pick(option, "adds", 0)
        var up = storyUp()

        if (pick(up, "kind", "card") == "fight")
        {
            push(parts, "A fight, by his own hand")
        }
        else if (pick(swap, "from", "") != "")
        {
            push(parts, "Leans on " + toLowerCase(statName(swap.to)) + " in place of " + toLowerCase(statName(swap["from"])))
        }
        else if (adds > 0)
        {
            push(parts, "Counts for more than was taught")
        }
        else if (adds < 0)
        {
            push(parts, "Counts for less than was taught")
        }
        else
        {
            push(parts, "Leans on what he was taught")
        }
    }

    return joined(parts, " · ")
}

// The card up, for the event screen
fun storyCardPage()
{
    var up = storyUp()

    if (up.id == "")
    {
        return {id: "", title: "", text: "", foot: ""}
    }

    var story = storyNow()
    var foot = "His answer is written to the day; the day goes on."

    if (upKind() == "test")
    {
        foot = "He sits it once, and it is his day's work."
    }
    else if (upKind() == "event")
    {
        foot = "A chance of the day: his answer is written to it."
    }

    return {id: run.event, title: up.title, text: up.text, foot: foot}
}

// Its answers: up to four, those he may not see left out, those he cannot give shut
fun storyOptionRows()
{
    var story = storyNow()
    var up = storyUp()
    var rows = []

    if (up.id == "")
    {
        return rows
    }

    var isTest = upKind() == "test"
    var isEvent = upKind() == "event"

    for (var i = 0; i < len(up.options) and len(rows) < 4; i++)
    {
        var option = up.options[i]

        if (not answerShown(option, isTest))
        {
            continue
        }

        var short = answerShort(option)

        if (isEvent)
        {
            short = optionShort(option)
        }

        var row = {id: option.id, label: option.label, line: answerLine(option, isTest), locked: 0, asks: short}

        if (short != "")
        {
            row.locked = 1
        }

        push(rows, row)
    }

    return rows
}

// An answer written as a step of the record: its line, its fee paid, its gifts given
fun answerStep(kind, target, days, option)
{
    var story = storyNow()

    openStep(kind, target, 1, days, pick(option, "line", option.label), story.glyph)

    var fee = pick(option, "fee", [])

    for (var i = 0; i < len(fee); i++)
    {
        after[fee[i].stat] = mine(fee[i].stat) - fee[i].amount
        push(marks, {step: len(record), kind: "fee", id: fee[i].stat, n: fee[i].amount})
    }

    var step = lastStep()

    if (feeText(option) != "")
    {
        step.used = "−" + feeText(option)
    }

    var gives = pick(option, "gives", [])

    for (var i = 0; i < len(gives); i++)
    {
        giveGift(gives[i])

        if (typeOf(gives[i].mark) == "none" and typeOf(gives[i].item) == "none" and giftText(gives[i]) != "")
        {
            step.gave = addTo(step.gave, giftText(gives[i]))
        }
    }
}

// The line's right for an answer: the days if it took any, his Vitality, what it cost and gave
fun answerFigure(days)
{
    var story = storyNow()
    var step = lastStep()
    var parts = []

    if (days > 0)
    {
        push(parts, toUpperCase(counted(days, story.unit, story.unit + "s")))
    }

    if (step.hp != 0)
    {
        push(parts, signed(step.hp) + " VIT")
    }

    if (step.used != "")
    {
        push(parts, toUpperCase(step.used))
    }

    if (step.gave != "")
    {
        push(parts, toUpperCase(step.gave))
    }

    step.figure = joined(parts, " · ")
}

// He drops out of the story (a fail, sent away, or he left): its flag, when it has one. He keeps
// all the days gave him
fun dropOut()
{
    var story = storyNow()

    if (pick(story, "dropout", "") != "")
    {
        after[story.dropout] = 1
    }
}

// A card answered: the answer's gifts, and the scene ended there if the answer ends it (the
// gate's card always does: he is sent away)
fun answerCard(card, option)
{
    var story = storyNow()
    var gate = pick(story, "gate", {})

    answerStep("card", card.id + "/" + option.id, 0, option)
    answerFigure(0)

    run["c." + card.id] = 1

    if (pick(option, "ends", "") == "dropout" or card.id == pick(gate, "card", ""))
    {
        run.result = "dropout"
        run.left = runOf("ap")
        run.ap = 0

        dropOut()
    }
}

// A chance meeting answered, as a walk's is (its days, his Vitality, things, stats), with a
// story's gifts besides
fun answerEvent(event, option)
{
    var story = storyNow()
    var ap = pick(option, "ap", 0)

    answerStep("event", event.id + "/" + option.id, ap, option)

    run["met." + event.id] = 1

    if (pick(event, "once", false))
    {
        after["met." + story.id + "." + event.id] = 1
    }

    if (pick(option, "hp", 0) != 0)
    {
        shiftHp(option.hp)
    }

    var items = pick(option, "items", [])

    for (var i = 0; i < len(items); i++)
    {
        if (items[i].amount < 0)
        {
            take(items[i].id, 0 - items[i].amount)
        }
        else
        {
            give(items[i].id, items[i].amount)
        }
    }

    var effects = pick(option, "effects", [])
    var step = lastStep()

    for (var i = 0; i < len(effects); i++)
    {
        if (effects[i].kind == "stat")
        {
            after[effects[i].stat] = raised(mine(effects[i].stat), effects[i].stat, effects[i].amount)
            push(marks, {step: len(record), kind: "stat", id: effects[i].stat, n: effects[i].amount})
            step.gave = addTo(step.gave, signed(effects[i].amount) + " " + statName(effects[i].stat))
        }
    }

    answerFigure(ap)

    if (ap > 0)
    {
        endDay(ap)
    }
}

// What a term of a test's score counts: a stat or mark times `times` (or `times` once at `at`),
// a flag `times` when held. The answer may read the term as another stat or mark
fun termValue(term, option)
{
    var kind = "stat"
    var key = pick(term, "stat", "")

    if (typeOf(term.mark) != "none")
    {
        kind = "mark"
        key = term.mark
    }
    else if (typeOf(term.flag) != "none")
    {
        kind = "flag"
        key = term.flag
    }

    var times = pick(term, "times", 1)
    var swap = pick(option, "swap", {})

    if (key != "" and pick(swap, "from", "") == key)
    {
        key = pick(swap, "to", key)
        times = pick(swap, "times", times)
    }

    var value = mine(key)

    if (kind == "mark")
    {
        value = markOf(key)
    }

    if (kind == "flag")
    {
        if (value > 0)
        {
            return times
        }

        return 0
    }

    var at = pick(term, "at", 0)

    if (at > 0)
    {
        if (value >= at)
        {
            return times
        }

        return 0
    }

    return value * times
}

// A test's score, sat with an answer: its terms, and what the answer adds
fun testScore(test, option)
{
    var score = pick(test, "score", [])
    var total = pick(option, "adds", 0)

    for (var i = 0; i < len(score); i++)
    {
        total = total + termValue(score[i], option)
    }

    return total
}

// Every test of the story sat
fun testsSat(story)
{
    var tests = pick(story, "tests", [])

    for (var i = 0; i < len(tests); i++)
    {
        if (runOf("sat." + tests[i].id) == 0)
        {
            return false
        }
    }

    return true
}

// A test sat with an answer: its score kept, its day spent; after the last, the result
fun sitTest(test, option)
{
    var score = testScore(test, option)

    answerStep("test", test.id + "/" + option.id, 1, option)
    answerFigure(1)

    testSat(test, score)
}

// A test sat, a card's or a fight's: its score kept, its day spent (the months it completes
// fall due); after the last, the result
fun testSat(test, score)
{
    var story = storyNow()

    run["score." + test.id] = score
    run["sat." + test.id] = 1

    endDay(1)

    if (testsSat(story))
    {
        storyResult()
    }
}

// The grade of the scores: the last of the story's grades (from the lowest up) whose floors and
// total are reached, the first when none is; {id: "over"} for a story with no grades
fun gradeOf()
{
    var story = storyNow()
    var grades = pick(story, "grades", [])

    if (len(grades) == 0)
    {
        return {id: "over", gives: []}
    }

    var tests = pick(story, "tests", [])
    var total = 0

    for (var i = 0; i < len(tests); i++)
    {
        total = total + runOf("score." + tests[i].id)
    }

    var best = grades[0]

    for (var i = 0; i < len(grades); i++)
    {
        var floors = pick(grades[i], "floors", {})
        var reached = total >= pick(grades[i], "total", 0)

        for (var k : floors)
        {
            if (runOf("score." + k) < floors[k])
            {
                reached = false
            }
        }

        if (reached)
        {
            best = grades[i]
        }
    }

    return best
}

// The tests are sat: the grade is his result and gives what it gives; a fail drops him out.
// The scene is over
fun storyResult()
{
    var story = storyNow()
    var grade = gradeOf()
    var gives = pick(grade, "gives", [])

    run.result = grade.id

    for (var i = 0; i < len(gives); i++)
    {
        giveGift(gives[i])
    }

    var kind = "note"

    if (grade.id == "fail")
    {
        kind = "loss"
        dropOut()
    }

    if (pick(grade, "line", "") != "")
    {
        push(entries, {text: grade.line, kind: kind, figure: "", glyph: story.glyph})
    }
    else if (grade.id != "over")
    {
        push(entries, {text: "Saw " + toLowerCase(story.name) + " to its end: " + grade.id, kind: kind, figure: "", glyph: story.glyph})
    }

    run.event = ""
    run.left = runOf("ap")
    run.ap = 0
}

// His answer to what is up (expeditionlib.pg's `chooseOption` hands it here in a story). The
// next card of the day comes up after it, if one waits
fun storyChoose(optionId)
{
    var story = storyNow()
    var up = storyUp()

    if (up.id == "")
    {
        run.refused = "No such choice"
        return
    }

    var isTest = upKind() == "test"
    var isCard = upKind() == "card"
    var option = optionOf(up, optionId)

    if (option.id == "" or not answerShown(option, isTest))
    {
        run.refused = "No such choice"
        return
    }

    var short = answerShort(option)

    if (not isTest and not isCard)
    {
        short = optionShort(option)
    }

    if (short != "")
    {
        run.refused = capitalised(toLowerCase(short))
        return
    }

    run.event = ""

    if (isTest and pick(up, "kind", "card") == "fight")
    {
        // Fought by hand: sat when he is back from it (storyFightBack)
        run.fightTest = up.id
        run.fightFrom = ""
        storyFight(pick(up, "mob", ""), pick(up, "count", 1), pick(up, "turns", 0))
    }
    else if (isTest)
    {
        sitTest(up, option)
    }
    else if (isCard)
    {
        answerCard(up, option)
    }
    else
    {
        answerEvent(up, option)
    }

    if (run.event == "")
    {
        openDue()
    }
}

// ---- the fights of a story -------------------------------------------------------------------------------
//
// A tile, a card or a test may open a fight: the walk's own (fightlib.pg), with no approach card
// and no zone, against a beast of the story's own or any. What he knows that day is in its menu
// (fightcalc.pg's `knowsTech` reads `after`, where what the scene taught has landed). Its turns
// are no days: the fight is the day's work, and the day ends when he is back from it (`back`).
// A story's beast may be one that spares (a dummy: it brings nobody down), and time may be
// called (`run.fightMost`: held, if neither side has fallen). Lost or fled, nothing the scene
// gave is lost and nobody is carried home. Its run keys, scalars as every run's are:
// `fightMost`, `fightDays` (the days the tile took: they end when he is back), `fightTest` (the
// test it is), `fightFrom` ("tile.<id>": whose `wins` a win gives)

// "the wolf" for "wolf", what has an article kept as it is
fun theName(name)
{
    if (startsWith(name, "the ") or startsWith(name, "a ") or startsWith(name, "an "))
    {
        return name
    }

    return "the " + name
}

// A fight of the story begins: `count` of the beast, time called after `most` of his turns (0:
// never)
fun storyFight(mobId, count, most)
{
    var mob = mobOf(mobId)

    if (mob.id == "")
    {
        push(errors, "unknown beast " + mobId)
        return
    }

    run.found = mob.id
    run.foundCount = larger(1, count)
    run.fightMost = most

    beginFight()
}

// A fight played on its own, by the stance's choices (fightauto.pg), to its end
fun fightOnItsOwn()
{
    for (var guard = 0; guard < 100 and fight.over == ""; guard++)
    {
        resolve(autoChoice())

        // (a choice it could not make: a strike in its place)
        if (pick(run, "refused", "") != "")
        {
            run.refused = ""
            resolve("strike")
        }
    }
}

// What a won fight gives, from what opened it: the `wins` of the tile's fight
fun fightWins(origin)
{
    if (not startsWith(origin, "tile."))
    {
        return []
    }

    var story = storyNow()
    var tile = storyTile(story, substring(origin, 5))
    var gives = pick(tile, "gives", [])

    for (var i = 0; i < len(gives); i++)
    {
        if (typeOf(gives[i].fight) != "none")
        {
            return pick(gives[i], "wins", [])
        }
    }

    return []
}

// The fight is over (fightlib.pg's `endFight` asks it in a story): its line in the scene's
// words, and he is not carried home. `length` and `hurt` are the walk's words for it
fun storyFightEnd(outcome, length, hurt)
{
    var step = lastStep()
    var what = theName(toLowerCase(fightName()))
    var said = account[len(account) - 1]

    step.tone = "time"

    if (outcome == "won")
    {
        step.text = "Beat " + what + " · " + length + ", " + hurt
        fight.spoils = "Written to the day"
        said.text = "It is over. " + step.text
    }
    else if (outcome == "held")
    {
        step.text = "Stood against " + what + " till time was called · " + length + ", " + hurt
    }
    else if (outcome == "fled")
    {
        step.text = "Broke off from " + what + " · " + length + ", " + hurt
        step.tone = "loss"
        fight.spoils = "The day is spent; what the days gave is kept"
        said.text = "He breaks off"
    }
    else
    {
        step.text = "Beaten by " + what + " · " + length
        step.tone = "loss"
        fight.spoils = "He is helped up: the day is spent, and what the days gave is kept"
        said.text = "He goes down, and is helped up"
    }

    // The line's right: its turns and what it took (no days: the day is the tile's or the test's)
    var parts = [toUpperCase(length)]

    if (step.hp < 0)
    {
        push(parts, "−" + toString(0 - step.hp) + " VIT")
    }

    if (step.gave != "")
    {
        push(parts, toUpperCase(step.gave))
    }

    step.figure = joined(parts, " · ")

    // Brought down, he is left with one Vitality and the scene goes on
    run.downed = 0
}

// Back from a fight of the story: what a win gives, the test it was sat, and the day ended:
// the tile's days, else one (a fight on its own, `auto`, is inside its tile's day, which ends it)
fun storyFightBack(auto)
{
    var story = storyNow()
    var outcome = fight.over
    var beaten = 0

    for (var i = 0; i < len(foes); i++)
    {
        if (foes[i].alive <= 0 and pick(foes[i], "fled", 0) == 0)
        {
            beaten = beaten + 1
        }
    }

    var reacted = pick(fight, "reactions", 0) > 0
    var testId = pick(run, "fightTest", "")
    var origin = pick(run, "fightFrom", "")
    var days = runOf("fightDays")

    run.found = ""
    run.foundCount = 0
    run.fightMost = 0
    run.fightTest = ""
    run.fightFrom = ""
    run.fightDays = 0
    run.downed = 0
    foes = []
    account = []
    fight = {over: "", mob: ""}

    if (outcome == "won")
    {
        var wins = fightWins(origin)

        for (var i = 0; i < len(wins); i++)
        {
            giveGift(wins[i])
        }
    }

    if (auto)
    {
        return
    }

    if (testId != "")
    {
        // The practical: ten for each beaten in its time, its bonus for a reaction made, and the
        // days he practised
        var test = storyTest(story, testId)
        var score = 10 * beaten + markOf("practised") * pick(test, "practised", 0)

        if (reacted)
        {
            score = score + pick(test, "reaction", 0)
        }

        countFightDay()
        testSat(test, score)
    }
    else if (days > 0)
    {
        endDay(days)
    }
    else
    {
        // A card's fight (or a meeting's): the day goes to it
        countFightDay()
        endDay(1)
    }
}

// The fight's line is a day of the scene: the day a test or a card's fight takes (a tile counted
// its own days when it was taken)
fun countFightDay()
{
    var step = lastStep()

    step.ap = step.ap + 1
    run.ap = larger(0, runOf("ap") - 1)
    run.spent = runOf("spent") + 1
}

// The head of the fight screen in a story (fightpage.pg's `duelHead`): the scene and its day, no
// days counted by turns
fun storyDuel(view)
{
    var story = storyNow()

    view.kicker = toUpperCase(story.name) + " · " + toUpperCase(storyDayText()) + " · A FIGHT"
    view.cost = "THE DAY'S WORK"
    view.daysLeft = toUpperCase(daysText(runOf("ap"))) + " LEFT"
    view.back = "Back to the day"
    view.low = ""
    view.dayText = "TURN " + toString(fight.turn)

    if (runOf("fightMost") > 0)
    {
        view.cost = "TIME IS CALLED AFTER " + toUpperCase(counted(runOf("fightMost"), "turn", "turns"))
        view.dayText = "TURN " + toString(fight.turn) + " OF " + toString(runOf("fightMost"))
    }

    var lost = fight.hpStart - runOf("hp")

    view.footnote = toString(larger(0, lost)) + " VITALITY LOST · WHAT THE DAYS GAVE IS KEPT, WHATEVER COMES"
}

// ---- the page ---------------------------------------------------------------------------------------------

// The day he is on, in words: "third day"; the last day once the scene is over
fun storyDayText()
{
    var words = ["first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth", "eleventh", "twelfth"]
    var day = smaller(runOf("day"), larger(1, runOf("days")))

    if (day >= 1 and day <= len(words))
    {
        return words[day - 1] + " " + storyNow().unit
    }

    return storyNow().unit + " " + toString(day)
}

// The stage of the day he is on ({"from": 0, title: ""} when none)
fun storyStage(story)
{
    var stages = pick(story, "stages", [])
    var day = smaller(runOf("day"), larger(1, runOf("days")))

    for (var i = 0; i < len(stages); i++)
    {
        if (day >= stages[i]["from"] and day <= stages[i].to)
        {
            return stages[i]
        }
    }

    return {title: "", text: ""}
}

// The head of the page: the story, the day of how many, the stage, his Vitality and Leave
fun storyHead()
{
    var story = storyNow()
    var stage = storyStage(story)
    var day = smaller(runOf("day"), larger(1, runOf("days")))
    var unit = capitalised(story.unit)
    var leave = "Leave"
    var leaveNote = "WHAT HE WAS GIVEN IS HIS"

    if (runOf("leaving") > 0)
    {
        leave = "Leave: " + daysText(runOf("ap")) + " are lost"
        leaveNote = "PRESS AGAIN TO GO"

        if (pick(story, "dropout", "") != "")
        {
            leaveNote = "HE DROPS OUT. PRESS AGAIN TO GO"
        }
    }

    var percent = 0
    var stageText = ""

    // (said on a stage's first day only)
    if (stage.title != "" and day == stage["from"])
    {
        stageText = stage.text
    }

    if (runOf("days") > 0)
    {
        percent = wholeOf(runOf("spent") * 100, runOf("days"))
    }

    return {story: story.id, zone: "", mode: run.mode,
            kicker: toUpperCase(stage.title),
            title: story.name, line: stage.text,
            day: day, days: runOf("days"), unit: story.unit, dayText: unit + " " + toString(day) + " of " + toString(runOf("days")),
            stage: stage.title, stageText: stageText,
            months: runOf("monthsRun"), monthsTotal: runOf("months"), standing: standingLine(story),
            daysLeft: toString(runOf("ap")), daysNote: toUpperCase(story.unit) + "S LEFT",
            vitality: "VITALITY " + toString(runOf("hp")) + " OF " + toString(runOf("hpMax")),
            vitalityPercent: wholeOf(runOf("hp") * 100, larger(1, runOf("hpMax"))),
            knowledge: "", knowledgeNote: "",
            home: toUpperCase(counted(runOf("monthsRun"), "month", "months") + " gone by of " + toString(runOf("months"))),
            percent: smaller(100, percent),
            caption: toUpperCase(story.unit + " " + toString(day) + " of " + toString(runOf("days")) + " · " + counted(runOf("monthsRun"), "month", "months") + " gone by"),
            written: "", leave: leave, leaveNote: leaveNote, watchCost: "",
            summary: "", scribe: "Each " + story.unit + " is chosen when it comes.",
            result: pick(run, "result", ""),
            refused: pick(run, "refused", "")}
}

// The tiles of the day, as a walk's works are: shown ones only, shut ones with what they ask
fun storyTiles()
{
    var story = storyNow()
    var tiles = pick(story, "tiles", [])
    var rows = []

    if (run.mode == "done")
    {
        return rows
    }

    for (var i = 0; i < len(tiles); i++)
    {
        var tile = tiles[i]

        if (not tileOffered(tile))
        {
            continue
        }

        var cost = pick(tile, "cost", 1)
        var days = counted(cost, story.unit, story.unit + "s")
        var fee = feeText(tile)
        var costs = days

        if (fee != "")
        {
            costs = days + ", " + fee
        }

        var row = workRow("tile." + tile.id, tile.name, toUpperCase(fee), cost, tileShort(tile), "", pick(tile, "about", ""), costs, givesText(story, tile))

        row.costText = days

        // (kept in the run when the day began: a look must say the same)
        if (pick(run, "seen." + tile.id, 0) == runOf("day"))
        {
            row.fresh = 1
        }

        push(rows, row)
    }

    return rows
}

// What the scene has given so far: its marks in words, the stats he gained, the things he holds
fun storyTaken()
{
    var story = storyNow()
    var rows = []
    var named = markIds(marks, "mark")

    for (var i = 0; i < len(named); i++)
    {
        push(rows, {id: "m." + named[i], name: markName(story, named[i]), glyph: story.glyph, value: wordOf(markOf(named[i])), tone: "know"})
    }

    var stats = markIds(marks, "stat")

    for (var i = 0; i < len(stats); i++)
    {
        push(rows, {id: "stat." + stats[i], name: statName(stats[i]), glyph: "training", value: "+" + toString(sumMarks(marks, "stat", stats[i])), tone: "gain"})
    }

    var items = markIds(marks, "gain")

    for (var i = 0; i < len(items); i++)
    {
        push(rows, {id: "got." + items[i], name: itemOf(items[i]).name, glyph: itemOf(items[i]).glyph, value: "+" + toString(runOf("got." + items[i])), tone: "gain"})
    }

    return rows
}

// If he left now: the months gone by, what he keeps, and for a class that he drops out
fun storyHome()
{
    var story = storyNow()
    var rows = []

    push(rows, {id: "time", name: "Months gone by", glyph: "time", value: counted(runOf("monthsRun"), "month", "months") + " of " + toString(runOf("months")), tone: "time"})
    push(rows, {id: "keeps", name: "He keeps", glyph: story.glyph, value: "what he was given", tone: "gain"})

    var paid = markIds(marks, "fee")

    for (var i = 0; i < len(paid); i++)
    {
        push(rows, {id: "paid." + paid[i], name: statName(paid[i]) + " paid", glyph: "gold", value: toString(sumMarks(marks, "fee", paid[i])) + " " + toLowerCase(statName(paid[i])), tone: "loss"})
    }

    if (pick(story, "dropout", "") != "")
    {
        push(rows, {id: "dropout", name: "Leaving now", glyph: "gate", value: "is dropping out", tone: "loss"})
    }

    return rows
}
