// depgraph.pg - what each task of Chronicle depends on, as a Graphviz file.
//
// A tool: the game never loads it. It stands with the rules because a module's own imports are
// looked for beside the script that is run, and activitytable.pg imports lib.pg and towntable.pg.
//
// Reads the activity table, the town table and the expedition table of the game and writes one
// of two pictures.
//
// The timeline (no focus), an SVG: the years run left to right, a month is `monthWidth` wide.
//   - A task is a bar from the month it can first be begun, as wide as the months it takes: two
//     bars that share a stretch of the axis cannot both be done in it. That month is its age
//     (`fromAge`, and its `fromMonths` past that birthday: "from 6y4m"), or the month the task
//     that brings a flag it asks for is over, when that is later. The line after a bar runs to
//     the age it must be over by, to the month too. What it asks, takes and brings is written
//     on it.
//   - A frame a group, as wide as its tasks and as high on the page as the frames over its years
//     allow: a childhood's groups stand beside a class's, not over them. The ways into a class
//     come first, in gold; a task of a class has a stripe of the class's colour, and its group
//     a frame of it.
//   - An arrow goes from the task that brings a flag (a title, a deed, a friend) to the task that
//     reads it, from where the first ends to where the second begins.
//   - No arrow for what is only a number to reach or to spend: the skills, which `skillFrom` tasks
//     or more bring, what a life is born with, and whatever a task takes as a cost (coin, rations,
//     reagents, favors). They are written on the bars.
//   - The town is a frame like the others. A place is a box that begins where the task that brings
//     it onto the Town page ends (its `shows`: a task done, or the task that gives the flag it
//     asks for; the task that makes the town known, for a place there from the start), with an
//     arrow from that task. Its three works are bars end to end, each as wide as its months (and
//     the years of his life it takes), over what each asks and gives. No arrow comes out of
//     the town. A task a level unlocks (it asks for the level, or the level opens it to every
//     class) has a purple chip before it, "The Market 3", and stays at its own age: what the
//     town sells is on the page from the start. A task a level only makes better says so on
//     its bar ("town: The Mill 1").
//
//   - A walk outside the town is a red bar of the Adventure frame, as wide as the months it
//     blocks. Its row of the table says nothing of what it brings (a walk is played on a screen
//     of its own), so that is read from the expedition table: its days, what is gathered there,
//     and a line a beast with what it leaves. What a walk brings home
//     has no arrow: what takes it (what is sold or brewed of it at the market, a place of the
//     town that is built of it) has a red chip before it with every walk that brings it,
//     "The Hedgerows, The Quarry Road", and the thing before them when it takes several
//     ("stone: The Quarry Road"). What is sold or brewed stands where the first of those walks
//     is over. A walk another asks for (walked, or studied) has an arrow like any flag.
//   - A task that gives a flag a technique of a fight is learned by says so on its bar
//     ("in a fight: Sweep"): no arrow, every walk with a beast would have one.
//
//   - A second calling is drawn as a class is: its ways in are gold, in the frame of the group
//     `callingGroup`, beside the classes'; its works have no arrow from it, their frame says
//     which way in opened it, and a task that leads to one has its name on a chip ("Castellan").
//   - No arrow goes into a way into a class: too many would climb to the same frame. The task
//     that brings what a way in reads (asks for, is eased by, takes as one of several) has a
//     gold chip after its bar instead, in the class's colour: "The Keep (arms 2)".
//   - A task that asks for another one done ("done.yard" among what it asks) has an arrow from
//     it, like a flag's.
//
// A focus (the id of a task, "keep", or the key of a stat, "arms", "town.mill"), a Graphviz file:
// the detail around it, with a node for every stat. For a task: what it asks, takes and brings,
// the tasks that bring what it asks and the tasks that read what it brings. For a stat: the tasks
// that bring it and the tasks that read it. Both lists of tasks are printed. "all" as the focus
// is the whole detail at once: a ball of wool, there to search in.
//
//   black   a task asks for it
//   red     a task takes it when it begins (a cost)
//   blue    a task brings it (dashed: only at a later term, or with a bonus)
//   green   it makes a task easier (dashed) or better (solid), or is one of several that will do
//   grey    a task is of a class
//   purple  the town: a work raises a place, a place gives a new life something at birth
//   orange  a fight: a flag teaches a technique ("fight.sweep", a hexagon), and a walk makes
//           use of it, or of a remedy he holds (dashed)
//
// Usage:  PgCompilerBootstrap examples/Chronicle/rules/depgraph.pg [out.svg]
//         PgCompilerBootstrap examples/Chronicle/rules/depgraph.pg <out.dot> <focus>
//         PgCompilerBootstrap examples/Chronicle/rules/depgraph.pg --facts <out.txt>
//                 (the earliest months of every task and the loose ends, as lines: see writeFacts;
//                 what the solver reads)
//         dot -Tsvg out.dot -o out.svg
//
// The file is chronicle-graph.svg, or chronicle-graph.dot with a focus, where it is run from,
// when none is given. Without a focus the loose ends are printed: what is asked for and brought
// by nothing, and what is brought and read by no task.

import "string"
import "file"
import "algorithm"
import "math"

// ============================================================================
// Settings
// ============================================================================

// What is written in a task's box and never drawn
var hubStats = ["coin", "rations"]

// A stat that this many tasks bring, or more, is a skill: the timeline writes it on the bars
var skillFrom = 3

// The timeline: the width of a month, the height of a line of text, the gap between two rows,
// and the width a letter is counted for when a bar's text is measured
var monthWidth = 12
var lineHeight = 13
var rowGap = 10
var letterWidth = 6

// The room between a frame of the timeline and the one under it, and between a frame's side
// and its first bar
var frameGap = 14
var framePad = 6

// The room between a task's bar and the chip before it
var chipGap = 16

// The town's colour, and the colour of a place's first, second and third work
var townColour = "#6b46c1"
var workColours = ["#e9d8fd", "#d6bcfa", "#b794f4"]

// A walk's colour: its frame, its bars, and the chip before what takes a thing it brings
var walkColour = "#c53030"
var walkFill = "#fed7d7"

// The height a chip takes before a bar, with the room under it
var chipTall = 22

// The group of the ways into a second calling: each is drawn as a way into a class is (gold, no
// arrow out of it), and the works that ask for what it brings as the works of a class are
var callingGroup = "A second calling"

// The colour of each class, in the order of the table's `paths`
var classColours = ["#2b6cb0", "#6b46c1", "#2f855a", "#975a16"]

// What a life holds from its first day: nothing has to bring it
var bornWith = ["str", "dex", "int", "vit", "coin", "rations"]

// How each kind of link is drawn
var linkStyles = {
    asks: "color=\"#1a202c\", penwidth=1.6",
    takes: "color=\"#c53030\", fontcolor=\"#c53030\"",
    brings: "color=\"#2b6cb0\", fontcolor=\"#2b6cb0\"",
    later: "color=\"#2b6cb0\", fontcolor=\"#2b6cb0\", style=dashed",
    eases: "color=\"#2f855a\", fontcolor=\"#2f855a\", style=dashed",
    betters: "color=\"#2f855a\", fontcolor=\"#2f855a\"",
    classOf: "color=\"#a0aec0\", style=dotted, arrowsize=0.6",
    town: "color=\"#6b46c1\", fontcolor=\"#6b46c1\"",
    birth: "color=\"#6b46c1\", fontcolor=\"#6b46c1\", style=dashed",
    shows: "color=\"#6b46c1\", fontcolor=\"#6b46c1\", penwidth=1.6",
    opens: "color=\"#6b46c1\", fontcolor=\"#6b46c1\", penwidth=1.6",
    teaches: "color=\"#c05621\", fontcolor=\"#c05621\"",
    uses: "color=\"#c05621\", fontcolor=\"#c05621\", style=dashed"
}

// The kinds that bring a stat, and the kinds that read one
var bringKinds = ["brings", "later", "town", "birth"]
var readKinds = ["asks", "takes", "eases", "betters", "classOf", "shows", "opens", "teaches", "uses"]

// ============================================================================
// Helpers
// ============================================================================

fun inList(list, value)
{
    for (var i = 0; i < len(list); i = i + 1)
    {
        if (list[i] == value)
        {
            return true
        }
    }

    return false
}

// A text between the double quotes of a Graphviz file: a line break is written as it reads one
fun quoted(text)
{
    var out = ""

    for (var i = 0; i < strlen(text); i = i + 1)
    {
        var c = substring(text, i, i + 1)

        if (c == "\n")
        {
            c = "\\n"
        }
        else if (c == "\"" or c == "\\")
        {
            out = out + "\\"
        }

        out = out + c
    }

    return out
}

// A text of an SVG file
fun xmlText(text)
{
    var out = ""

    for (var i = 0; i < strlen(text); i = i + 1)
    {
        var c = substring(text, i, i + 1)

        if (c == "&")
        {
            c = "&amp;"
        }
        else if (c == "<")
        {
            c = "&lt;"
        }
        else if (c == ">")
        {
            c = "&gt;"
        }

        out = out + c
    }

    return out
}

// An age to the month: "6" at a birthday, "6y4m" four months past it
fun ageOfMonth(months)
{
    var years = toInt(floor(months / 12))
    var past = months - years * 12

    if (past == 0)
    {
        return toString(years)
    }

    return toString(years) + "y" + toString(past) + "m"
}

// "2-4", or "2" when the two are the same
fun rangeOf(least, most)
{
    if (most > least)
    {
        return toString(least) + "-" + toString(most)
    }

    return toString(least)
}

fun daysOf(count)
{
    if (count == 1)
    {
        return "1 day"
    }

    return toString(count) + " days"
}

fun taskNode(id)
{
    return "task/" + id
}

fun statNode(stat)
{
    return "stat/" + stat
}

fun signedText(amount)
{
    if (amount >= 0)
    {
        return "+" + toString(amount)
    }

    return toString(amount)
}

// "+1 Arms +18 Coin" for a [{stat, amount}], with the hubs only or without them
fun amountsText(list, sign, hubs)
{
    var out = ""

    for (var i = 0; i < len(list); i = i + 1)
    {
        if (inList(hubStats, list[i].stat) == hubs)
        {
            if (out != "")
            {
                out = out + " "
            }

            out = out + signedText(sign * list[i].amount) + " " + toLowerCase(statShortName(list[i].stat))
        }
    }

    return out
}

// ============================================================================
// The graph
// ============================================================================

fun newGraph()
{
    return {tasks: [], taskIds: {}, stats: [], statKeys: {}, statLabels: {}, links: [], groups: [], things: {}, callings: {}}
}

fun addStat(graph, stat)
{
    if (not contain(graph.statKeys, stat))
    {
        graph.statKeys[stat] = true
        push(graph.stats, stat)
    }
}

// A link from a stat to a task, or from a task to a stat. A hub is not drawn. `level` is how
// much of the stat the link holds from (a place's level), 0 when that says nothing
fun addLink(graph, source, target, stat, kind, label, level)
{
    if (inList(hubStats, stat))
    {
        return
    }

    addStat(graph, stat)
    push(graph.links, {source: source, target: target, stat: stat, kind: kind, label: label, level: level})
}

// What a bonus step changes, in a few words: "+4 coin", "months 4", "fromAge 8"
fun bonusText(step)
{
    var out = ""

    for (var key : step)
    {
        if (key != "stat" and key != "needed")
        {
            var said = ""

            if (key == "costs")
            {
                // What it takes besides, while he holds the stat
                for (var c = 0; c < len(step.costs); c = c + 1)
                {
                    if (said != "")
                    {
                        said = said + " "
                    }

                    said = said + "takes " + toString(lookup(step.costs[c], "amount", 1)) + " " + toLowerCase(statShortName(step.costs[c].stat))
                }
            }
            else if (key != "gains" and key != "more")
            {
                said = key + " " + toString(step[key])
            }
            else
            {
                said = amountsText(step[key], 1, true)

                if (said != "" and amountsText(step[key], 1, false) != "")
                {
                    said = said + " "
                }

                said = said + amountsText(step[key], 1, false)

                if (key == "gains")
                {
                    said = "brings " + said
                }
            }

            if (out != "")
            {
                out = out + ", "
            }

            out = out + said
        }
    }

    return out
}

fun addTask(graph, a)
{
    var node = taskNode(a.id)

    // Its box: its name, its time and its ages, and what it does to the hubs
    var time = "at once"

    if (a.months > 0)
    {
        time = toString(a.months) + " mo"
    }

    // Its ages, to the month (`fromMonths` and `finishMonths` are the months past the birthday)
    var fromMonth = a.fromAge * 12 + lookup(a, "fromMonths", 0)
    var byMonth = a.finishBy * 12 + lookup(a, "finishMonths", 0)

    time = time + " | from " + ageOfMonth(fromMonth)

    if (a.finishBy < anyAge and a.finishBy < lastAge)
    {
        time = time + " | by " + ageOfMonth(byMonth)
    }

    if (a.uses > 0)
    {
        time = time + " | x" + toString(a.uses)
    }

    var label = a.name + "\n" + time

    var hubs = amountsText(a.gains, 1, true)
    var paid = amountsText(a.costs, -1, true)

    if (hubs != "" and paid != "")
    {
        hubs = hubs + " "
    }

    hubs = hubs + paid

    if (hubs != "")
    {
        label = label + "\n" + hubs
    }

    push(graph.tasks, {id: a.id, node: node, group: a.group, label: label, name: a.name, time: time, fromAge: a.fromAge, finishBy: a.finishBy, fromMonth: fromMonth, byMonth: byMonth, months: a.months, path: a.path, enters: a.enters, raises: a.raises,
                       zone: lookup(a, "zone", ""), lastResort: lookup(a, "lastResort", false), calling: "", under: "",
                       needs: a.needs, gains: a.gains, costs: a.costs})
    graph.taskIds[a.id] = true

    if (not inList(graph.groups, a.group))
    {
        push(graph.groups, a.group)
    }

    // What it brings at every term
    var brought = {}

    for (var g = 0; g < len(a.gains); g = g + 1)
    {
        brought[a.gains[g].stat] = true
        addLink(graph, node, statNode(a.gains[g].stat), a.gains[g].stat, "brings", signedText(a.gains[g].amount), 0)
    }

    // What it takes when it begins
    for (var c = 0; c < len(a.costs); c = c + 1)
    {
        addLink(graph, statNode(a.costs[c].stat), node, a.costs[c].stat, "takes", signedText(0 - a.costs[c].amount), 0)
    }

    // What it asks, as the table writes it
    for (var r = 0; r < len(a.needs); r = r + 1)
    {
        var req = a.needs[r]

        if (has(req, "anyOf"))
        {
            for (var f = 0; f < len(req.anyOf); f = f + 1)
            {
                addLink(graph, statNode(req.anyOf[f]), node, req.anyOf[f], "eases", "or", 1)
            }
        }
        else
        {
            addLink(graph, statNode(req.stat), node, req.stat, "asks", toString(req.needed), req.needed)

            // Another task done ("done.yard"): that task is what brings it
            if (startsWith(req.stat, "done.") and not contain(graph.statLabels, req.stat))
            {
                var asked = substring(req.stat, 5, strlen(req.stat))

                graph.statLabels[req.stat] = byId(activities, asked).name + ", done"
                addLink(graph, taskNode(asked), statNode(req.stat), req.stat, "brings", "done", 0)
            }
        }

        if (has(req, "eased"))
        {
            var easings = req.eased

            if (typeOf(easings) != "array")
            {
                easings = [req.eased]
            }

            for (var e = 0; e < len(easings); e = e + 1)
            {
                var said = toLowerCase(statShortName(req.stat)) + " " + toString(easings[e].needed)

                if (has(easings[e], "at"))
                {
                    said = "at " + toString(easings[e].at) + ": " + said
                }

                addLink(graph, statNode(easings[e].flag), node, easings[e].flag, "eases", said, lookup(easings[e], "at", 1))
            }
        }
    }

    // What it comes after (its `follows`): no row until that task is behind him, so an arrow from
    // it, as for a task it asks done
    var befores = asList(lookup(a, "follows", []))

    for (var b = 0; b < len(befores); b = b + 1)
    {
        var prior = "done." + befores[b]

        addLink(graph, statNode(prior), node, prior, "asks", "after", 1)

        if (not contain(graph.statLabels, prior))
        {
            graph.statLabels[prior] = byId(activities, befores[b]).name + ", done"
            addLink(graph, taskNode(befores[b]), statNode(prior), prior, "brings", "done", 0)
        }
    }

    // What repetition brings that the first term does not
    for (var s = 0; s < len(a.after); s = s + 1)
    {
        var step = a.after[s]
        var gains = listOf(step, "gains")
        var effects = listOf(step, "effects")

        for (var g = 0; g < len(gains); g = g + 1)
        {
            if (not contain(brought, gains[g].stat))
            {
                addLink(graph, node, statNode(gains[g].stat), gains[g].stat, "later", signedText(gains[g].amount) + " from term " + toString(step.uses + 1), 0)
            }
        }

        for (var e = 0; e < len(effects); e = e + 1)
        {
            addLink(graph, node, statNode(effects[e].stat), effects[e].stat, "later", signedText(effects[e].amount) + " at term " + toString(step.uses), 0)
        }
    }

    // What a stat he holds, or the town, makes of it
    var bonuses = listOf(a, "bonus")

    for (var b = 0; b < len(bonuses); b = b + 1)
    {
        var better = bonuses[b]
        var level = lookup(better, "needed", 1)

        addLink(graph, statNode(better.stat), node, better.stat, "betters", "at " + toString(level) + ": " + bonusText(better), level)

        // A step that takes the task out of its class opens it to everyone: more than a better term
        if (has(better, "path"))
        {
            if (better.path == "")
            {
                addLink(graph, statNode(better.stat), node, better.stat, "opens", "at " + toString(level) + ": open to every class", level)
            }
        }

        for (var k = 0; k < 2; k = k + 1)
        {
            var more = listOf(better, "gains")

            if (k == 1)
            {
                more = listOf(better, "more")
            }

            for (var g = 0; g < len(more); g = g + 1)
            {
                if (not contain(brought, more[g].stat))
                {
                    addLink(graph, node, statNode(more[g].stat), more[g].stat, "later", signedText(more[g].amount) + " with " + toLowerCase(statShortName(better.stat)) + " " + toString(level), 0)
                }
            }
        }
    }

    // The class it is of: its way in brings the flag, the others are listed to who holds it
    if (a.path != "" and not a.enters)
    {
        var flag = pathFlagOf(paths, a.path)

        addLink(graph, statNode(flag), node, flag, "classOf", "", 1)
    }

    // A work of the town: the place it raises, and the level the place must be at
    if (a.raises != "")
    {
        var place = "town." + a.raises

        addLink(graph, node, statNode(place), place, "town", "to " + toString(a.level), a.level)

        if (a.level > 1)
        {
            addLink(graph, statNode(place), node, place, "asks", toString(a.level - 1), a.level - 1)
        }
    }
}

// What a walk brings that its row of the table does not say (its `gains` are empty: a walk is
// played on a screen of its own, expeditiontable.pg): what is gathered there, what its beasts
// leave, what its events give, and the two flags another task may
// ask for (the place walked, its studies), when one does. And what it makes use of: a remedy
// he holds, drunk there
fun addWalk(graph, zone)
{
    var node = taskNode("walk." + zone.id)

    if (not contain(graph.taskIds, "walk." + zone.id))
    {
        return
    }

    var brought = {}

    for (var s = 0; s < len(zone.spots); s = s + 1)
    {
        var spot = zone.spots[s]

        brought[spot.id] = true
        graph.things[spot.id] = true
        addLink(graph, node, statNode(spot.id), spot.id, "brings", "+" + rangeOf(spot.least, spot.most) + " for " + daysOf(spot.ap), 0)
    }

    for (var m = 0; m < len(zone.mobs); m = m + 1)
    {
        var mob = byId(walkMobs, zone.mobs[m])

        for (var d = 0; d < len(mob.loot); d = d + 1)
        {
            var drop = mob.loot[d]

            brought[drop.id] = true
            graph.things[drop.id] = true
            addLink(graph, node, statNode(drop.id), drop.id, "brings", "+" + rangeOf(drop.least, drop.most) + " a " + toLowerCase(mob.name) + ", " + toString(drop.chance) + "%", 0)
        }
    }

    for (var e = 0; e < len(zone.events); e = e + 1)
    {
        var event = byId(walkEvents, zone.events[e])

        for (var o = 0; o < len(event.options); o = o + 1)
        {
            var option = event.options[o]

            for (var i = 0; i < len(option.items); i = i + 1)
            {
                if (option.items[i].amount > 0 and not contain(brought, option.items[i].id))
                {
                    brought[option.items[i].id] = true
                    graph.things[option.items[i].id] = true
                    addLink(graph, node, statNode(option.items[i].id), option.items[i].id, "brings", signedText(option.items[i].amount) + " by " + event.title, 0)
                }
            }

            for (var f = 0; f < len(option.effects); f = f + 1)
            {
                if (option.effects[f].kind == "stat")
                {
                    addLink(graph, node, statNode(option.effects[f].stat), option.effects[f].stat, "later", signedText(option.effects[f].amount) + " by " + event.title, 0)
                }
            }
        }
    }

    if (contain(graph.statKeys, "walked." + zone.id))
    {
        addLink(graph, node, statNode("walked." + zone.id), "walked." + zone.id, "brings", "+1", 0)
    }

    if (contain(graph.statKeys, "know.study." + zone.id))
    {
        addLink(graph, node, statNode("know.study." + zone.id), "know.study." + zone.id, "brings", "+1 a study, " + daysOf(walkKnobs.studyAp), 0)
    }

    var remedy = byId(walkItems, "remedy")

    addLink(graph, statNode("remedy"), node, "remedy", "uses", "drunk there: " + toString(remedy.heals) + "% of his Vitality", 1)
}

// Reads the tables the import below leaves: `activities`, `paths` and `townPlaces`, and the
// expeditions' (`walkZones`, `walkMobs`, `walkEvents`, `walkItems`, `walkTechniques`)
fun buildGraph()
{
    var graph = newGraph()

    for (var i = 0; i < len(activities); i = i + 1)
    {
        addTask(graph, activities[i])
    }

    // A familiar makes its things every month it is fed (resources.pg), which no row of the
    // table says: what a kind makes is brought by the work that binds it, from when that is over
    for (var k = 0; k < len(familiarKinds); k = k + 1)
    {
        var kind = familiarKinds[k]
        var binder = "bind." + kind.id

        if (contain(graph.taskIds, binder))
        {
            for (var m = 0; m < len(kind.makes); m = m + 1)
            {
                addLink(graph, taskNode(binder), statNode(kind.makes[m].stat), kind.makes[m].stat, "brings", signedText(kind.makes[m].amount) + " a month, fed", 0)
            }
        }
    }

    // What the stash keeps of a basic is what lives before him held of it at their death
    for (var b = 0; b < len(basicResources); b = b + 1)
    {
        var kept = basicResources[b].id

        addLink(graph, statNode(kept), statNode("stash." + kept), "stash." + kept, "birth", "kept at his death", 0)
    }

    // The walks, once every task has said what it asks for
    for (var z = 0; z < len(walkZones); z = z + 1)
    {
        addWalk(graph, walkZones[z])
    }

    // A second calling is a class of its own on the picture. The way into one brings a flag its
    // works ask for: those asks are drawn as a class's are (no arrow: a stripe, and the frame
    // says what opened it). `calling` on the way in is that flag, `under` on a work the flag of
    // the calling it is of
    for (var i = 0; i < len(graph.tasks); i = i + 1)
    {
        var way = graph.tasks[i]

        if (way.group != callingGroup)
        {
            continue
        }

        // The flag of the calling: what it alone brings, and another task asks for
        for (var g = 0; g < len(way.gains); g = g + 1)
        {
            var stat = way.gains[g].stat
            var asked = false
            var others = false

            for (var l = 0; l < len(graph.links); l = l + 1)
            {
                var link = graph.links[l]

                if (link.kind == "asks" and link.source == statNode(stat) and link.target != way.node)
                {
                    asked = true
                }

                if ((link.kind == "brings" or link.kind == "later") and link.target == statNode(stat) and link.source != way.node)
                {
                    others = true
                }
            }

            if (asked and not others)
            {
                way.calling = stat
                graph.callings[stat] = way.name
            }
        }
    }

    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        var link = graph.links[l]

        if (link.kind != "asks" or not contain(graph.callings, link.stat) or link.source != statNode(link.stat))
        {
            continue
        }

        link.kind = "classOf"
        link.label = ""

        for (var i = 0; i < len(graph.tasks); i = i + 1)
        {
            if (graph.tasks[i].node == link.target)
            {
                graph.tasks[i].under = link.stat
            }
        }
    }

    // What a fight offers to who has learned it: the flags that teach it, and the walks that
    // have a beast to use it on
    for (var t = 0; t < len(walkTechniques); t = t + 1)
    {
        var technique = walkTechniques[t]
        var key = "fight." + technique.id

        addStat(graph, key)
        graph.statLabels[key] = technique.name + ", a " + technique.kind + " of a fight"

        for (var k = 0; k < len(technique.knows); k = k + 1)
        {
            addLink(graph, statNode(technique.knows[k]), statNode(key), technique.knows[k], "teaches", "teaches", 1)
        }

        for (var z = 0; z < len(walkZones); z = z + 1)
        {
            if (len(walkZones[z].mobs) > 0 and contain(graph.taskIds, "walk." + walkZones[z].id))
            {
                addLink(graph, statNode(key), taskNode("walk." + walkZones[z].id), key, "uses", "in a fight", 1)
            }
        }
    }

    for (var t = 0; t < len(townPlaces); t = t + 1)
    {
        var place = townPlaces[t]
        var key = "town." + place.id

        addStat(graph, key)
        graph.statLabels[key] = place.name

        // What brings the place onto the Town page (its `shows`): a flag a task gives, or a task done
        var shows = lookup(place, "shows", {})

        if (has(shows, "flag"))
        {
            addLink(graph, statNode(shows.flag), statNode(key), shows.flag, "shows", "shows the place", 1)
        }

        if (has(shows, "done"))
        {
            addLink(graph, taskNode(shows.done), statNode(key), key, "shows", "shows the place, once done", 1)
        }

        // What a level gives a new life at birth
        for (var l = 0; l < len(place.levels); l = l + 1)
        {
            var given = listOf(place.levels[l], "start")

            for (var g = 0; g < len(given); g = g + 1)
            {
                addLink(graph, statNode(key), statNode(given[g].stat), given[g].stat, "birth", "at " + toString(l + 1) + ": born with " + signedText(given[g].amount), l + 1)
            }
        }
    }

    return graph
}

// ============================================================================
// Focus
// ============================================================================

// The nodes within `steps` links of one, along the links (forward) or against them. The graph
// loops through every skill (a task asks for Arms and brings Arms): followed to the end, any
// node reaches nearly all of them
fun reachFrom(graph, start, forward, steps)
{
    var seen = {}
    var queue = [start]
    var depth = {}
    var next = 0

    seen[start] = true
    depth[start] = 0

    while (next < len(queue))
    {
        var node = queue[next]
        next = next + 1

        if (depth[node] >= steps)
        {
            continue
        }

        for (var i = 0; i < len(graph.links); i = i + 1)
        {
            var link = graph.links[i]
            var other = ""

            if (forward and link.source == node)
            {
                other = link.target
            }

            if (not forward and link.target == node)
            {
                other = link.source
            }

            if (other != "" and not contain(seen, other))
            {
                seen[other] = true
                depth[other] = depth[node] + 1
                push(queue, other)
            }
        }
    }

    return seen
}

// The names of the tasks of a set of nodes, the focus left out
fun taskNames(graph, nodes, focus)
{
    var out = ""

    for (var i = 0; i < len(graph.tasks); i = i + 1)
    {
        if (contain(nodes, graph.tasks[i].node) and graph.tasks[i].node != focus)
        {
            if (out != "")
            {
                out = out + ", "
            }

            out = out + graph.tasks[i].id
        }
    }

    if (out == "")
    {
        return "nothing"
    }

    return out
}

// ============================================================================
// Output
// ============================================================================

fun statLabel(graph, stat)
{
    if (contain(graph.statLabels, stat))
    {
        return graph.statLabels[stat]
    }

    return statName(stat)
}

// The Graphviz text of the detail: all of it, or with a focus the nodes of `kept` only
fun emitDot(graph, kept, focus)
{
    var all = focus == ""
    var out = "digraph chronicle {\n"

    out = out + "    rankdir=LR;\n"
    out = out + "    labelloc=t;\n"
    out = out + "    label=\"Chronicle: black asks, red takes, blue brings (dashed: later or with a bonus), green eases or betters, grey is of the class, purple is the town, orange is a fight (a flag teaches a technique, a walk uses it)\";\n"
    out = out + "    node [fontname=\"Helvetica\", fontsize=11];\n"
    out = out + "    edge [fontname=\"Helvetica\", fontsize=9];\n\n"

    for (var g = 0; g < len(graph.groups); g = g + 1)
    {
        var body = ""

        for (var i = 0; i < len(graph.tasks); i = i + 1)
        {
            var task = graph.tasks[i]

            if (task.group == graph.groups[g] and (all or contain(kept, task.node)))
            {
                var style = ""

                if (task.node == focus)
                {
                    style = ", penwidth=3"
                }

                body = body + "        \"" + quoted(task.node) + "\" [label=\"" + quoted(task.label) + "\"" + style + "];\n"
            }
        }

        if (body != "")
        {
            out = out + "    subgraph \"cluster_" + toString(g) + "\" {\n"
            out = out + "        label=\"" + quoted(graph.groups[g]) + "\";\n"
            out = out + "        color=\"#a0aec0\";\n"
            out = out + "        node [shape=box, style=\"rounded,filled\", fillcolor=\"#f7fafc\"];\n"
            out = out + body
            out = out + "    }\n\n"
        }
    }

    for (var s = 0; s < len(graph.stats); s = s + 1)
    {
        var node = statNode(graph.stats[s])

        if (all or contain(kept, node))
        {
            var style = "shape=ellipse, style=filled, fillcolor=\"#fefcbf\""

            if (startsWith(graph.stats[s], "town."))
            {
                style = "shape=house, style=filled, fillcolor=\"#e9d8fd\""
            }

            if (startsWith(graph.stats[s], "fight."))
            {
                style = "shape=hexagon, style=filled, fillcolor=\"#feebc8\""
            }

            if (node == focus)
            {
                style = style + ", penwidth=3"
            }

            out = out + "    \"" + quoted(node) + "\" [label=\"" + quoted(statLabel(graph, graph.stats[s])) + "\", " + style + "];\n"
        }
    }

    out = out + "\n"

    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        var link = graph.links[l]

        if (all or (contain(kept, link.source) and contain(kept, link.target)))
        {
            out = out + "    \"" + quoted(link.source) + "\" -> \"" + quoted(link.target) + "\" [label=\"" + quoted(link.label) + "\", " + linkStyles[link.kind] + "];\n"
        }
    }

    return out + "}\n"
}

// ============================================================================
// The timeline
// ============================================================================

// The stats the timeline writes on the bars and draws no arrow for: the hubs, what a life is born
// with (and its cap), the skills, which `skillFrom` tasks or more bring, and what a task takes as
// a cost, which is spent and not held. What a walk brings home is none of them, however many
// walks bring it and whatever takes it: its arrows are what ties the walks to the market and
// to the town
fun foldedStats(graph)
{
    var bringers = {}
    var folded = {}

    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        var link = graph.links[l]

        if (link.kind == "takes" and not contain(graph.things, link.stat))
        {
            folded[link.stat] = true
        }

        if (startsWith(link.source, "task/") and (link.kind == "brings" or link.kind == "later"))
        {
            if (not contain(bringers, link.stat))
            {
                bringers[link.stat] = []
            }

            if (not inList(bringers[link.stat], link.source))
            {
                push(bringers[link.stat], link.source)
            }
        }
    }

    for (var s = 0; s < len(graph.stats); s = s + 1)
    {
        var stat = graph.stats[s]

        if (contain(bringers, stat))
        {
            if (len(bringers[stat]) >= skillFrom and not contain(graph.things, stat))
            {
                folded[stat] = true
            }
        }
    }

    for (var b = 0; b < len(bornWith); b = b + 1)
    {
        folded[bornWith[b]] = true
        folded[capOf(bornWith[b])] = true
    }

    for (var h = 0; h < len(hubStats); h = h + 1)
    {
        folded[hubStats[h]] = true
    }

    return folded
}

// The month of his life a task opens at. The last resort has no age of its own: it opens the
// month the last of the other ways into a class can no longer be begun
fun startMonth(graph, task)
{
    if (not task.lastResort)
    {
        return task.fromMonth
    }

    var latest = task.fromMonth

    for (var i = 0; i < len(graph.tasks); i = i + 1)
    {
        var other = graph.tasks[i]

        if (other.enters and not other.lastResort and other.byMonth - other.months > latest)
        {
            latest = other.byMonth - other.months
        }
    }

    return latest
}

// The levels of the town a task waits for, "The Market 3": the ones it asks for, and the ones
// that open it to every class. "" when it waits for none
fun unlockedBy(graph, task)
{
    var out = ""

    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        var link = graph.links[l]

        if (link.target == task.node and startsWith(link.stat, "town.") and (link.kind == "asks" or link.kind == "opens"))
        {
            var said = statLabel(graph, link.stat) + " " + toString(link.level)

            if (indexOf(out, said) < 0)
            {
                if (out != "")
                {
                    out = out + ", "
                }

                out = out + said
            }
        }
    }

    return out
}

// The place of a class among the table's `paths`, -1 for none
fun classIndex(path)
{
    for (var p = 0; p < len(paths); p = p + 1)
    {
        if (paths[p].id == path)
        {
            return p
        }
    }

    return -1
}

// The classes, and the second callings, a task leads to: the ways in that read a flag it brings (ask for it, are eased by
// it, or take it as one of several), a chip each, "The Keep (arms 2)". They stand after its bar
// in the place of the arrows, which would all climb to the same frame
fun classChips(graph, task, folded)
{
    var chips = []
    var seen = {}

    for (var b = 0; b < len(graph.links); b = b + 1)
    {
        var brings = graph.links[b]

        if (brings.source != task.node or (brings.kind != "brings" and brings.kind != "later"))
        {
            continue
        }

        if (contain(folded, brings.stat) or startsWith(brings.stat, "town") or contain(graph.things, brings.stat))
        {
            continue
        }

        for (var r = 0; r < len(graph.links); r = r + 1)
        {
            var reads = graph.links[r]

            if (reads.source != statNode(brings.stat) or reads.kind == "classOf" or reads.kind == "uses" or reads.kind == "takes" or reads.target == task.node)
            {
                continue
            }

            if (contain(seen, reads.target + ">" + brings.stat))
            {
                continue
            }

            for (var i = 0; i < len(graph.tasks); i = i + 1)
            {
                var way = graph.tasks[i]

                if (way.node != reads.target or not (way.enters or way.calling != "") or classIndex(way.path) < 0)
                {
                    continue
                }

                seen[reads.target + ">" + brings.stat] = true

                var text = paths[classIndex(way.path)].name

                // A second calling is named as what it makes of him: "Castellan"
                if (way.calling != "")
                {
                    text = statLabel(graph, way.calling)
                }

                if (reads.kind != "asks" or reads.label != "1")
                {
                    text = text + " (" + reads.label + ")"
                }

                if (brings.kind == "later")
                {
                    text = text + " [" + brings.label + "]"
                }

                push(chips, {text: text, wide: strlen(text) * letterWidth + 12, path: way.path})
            }
        }
    }

    return chips
}

// The SVG of the chips after a bar, one under the other, each with a short arrow from it: the
// classes it leads to, gold like a way in, in the class's colour
fun emitTails(tails, x, y)
{
    var out = ""

    for (var c = 0; c < len(tails); c = c + 1)
    {
        var chipX = x + chipGap
        var chipY = y + c * chipTall
        var colour = classColour(tails[c].path)

        out = out + "<line x1='" + toString(x + 2) + "' y1='" + toString(chipY + 9) + "' x2='" + toString(chipX - 2) + "' y2='" + toString(chipY + 9) + "' stroke='" + colour + "' stroke-width='1.8' marker-end='url(#way" + toString(classIndex(tails[c].path)) + ")'/>\n"
        out = out + "<rect x='" + toString(chipX) + "' y='" + toString(chipY) + "' width='" + toString(tails[c].wide) + "' height='18' rx='9' fill='#f6e05e' stroke='" + colour + "' stroke-width='1.5'/>\n"
        out = out + "<text x='" + toString(chipX + 6) + "' y='" + toString(chipY + 13) + "' style='fill: " + colour + "'>" + xmlText(tails[c].text) + "</text>\n"
    }

    return out
}

// The walks that bring what a task takes, a text a thing: "The Hedgerows, The Quarry Road",
// with the thing before it ("stone: The Quarry Road") when `named`, or when there are several.
// `nodes` is the task, or the works of a place of the town
fun walkChips(graph, nodes, named)
{
    var found = []
    var seen = {}

    for (var n = 0; n < len(nodes); n = n + 1)
    {
        for (var l = 0; l < len(graph.links); l = l + 1)
        {
            var link = graph.links[l]

            if (link.target != nodes[n] or link.kind != "takes" or not contain(graph.things, link.stat) or contain(seen, link.stat))
            {
                continue
            }

            seen[link.stat] = true

            var walks = ""

            for (var i = 0; i < len(graph.tasks); i = i + 1)
            {
                var brings = false

                for (var b = 0; b < len(graph.links); b = b + 1)
                {
                    if (graph.links[b].source == graph.tasks[i].node and graph.links[b].target == link.source and graph.links[b].kind == "brings")
                    {
                        brings = true
                    }
                }

                if (brings and graph.tasks[i].zone != "")
                {
                    if (walks != "")
                    {
                        walks = walks + ", "
                    }

                    walks = walks + graph.tasks[i].name
                }
            }

            if (walks != "")
            {
                push(found, {thing: toLowerCase(statLabel(graph, link.stat)), walks: walks})
            }
        }
    }

    var chips = []

    for (var f = 0; f < len(found); f = f + 1)
    {
        var text = found[f].walks

        if (named or len(found) > 1)
        {
            text = found[f].thing + ": " + text
        }

        push(chips, {text: text, wide: strlen(text) * letterWidth + 12, walk: true})
    }

    return chips
}

// The SVG of the chips before a bar or a place, one under the other, each with a short arrow
// to it: purple for a level of the town, red for the walks
fun emitChips(chips, x, y)
{
    var out = ""

    for (var c = 0; c < len(chips); c = c + 1)
    {
        var chip = chips[c]
        var chipX = x - chipGap - chip.wide
        var chipY = y + c * chipTall
        var colour = townColour
        var fill = workColours[0]
        var marker = "shows"

        if (chip.walk)
        {
            colour = walkColour
            fill = walkFill
            marker = "walks"
        }

        out = out + "<rect x='" + toString(chipX) + "' y='" + toString(chipY) + "' width='" + toString(chip.wide) + "' height='18' rx='9' fill='" + fill + "' stroke='" + colour + "' stroke-width='1'/>\n"
        out = out + "<text x='" + toString(chipX + 6) + "' y='" + toString(chipY + 13) + "' style='fill: " + colour + "'>" + xmlText(chip.text) + "</text>\n"
        out = out + "<line x1='" + toString(chipX + chip.wide) + "' y1='" + toString(chipY + 9) + "' x2='" + toString(x - 2) + "' y2='" + toString(chipY + 9) + "' stroke='" + colour + "' stroke-width='1.8' marker-end='url(#" + marker + ")'/>\n"
    }

    return out
}

// How long a walk is: the days on site (the longer stay is his once the place is well studied)
// and the way there
fun walkDays(zone)
{
    var stay = daysOf(zone.stayMin)

    if (zone.stayMax > zone.stayMin)
    {
        stay = toString(zone.stayMin) + " to " + toString(zone.stayMax) + " days"
    }

    return stay + " there, " + daysOf(zone.travel) + " each way"
}

// What a walk's bar says of the place: what is gathered there, a line, and a line a beast with
// what it leaves (the chance, when it is not sure)
fun walkLines(zone)
{
    var lines = []
    var gathers = ""

    for (var s = 0; s < len(zone.spots); s = s + 1)
    {
        if (gathers != "")
        {
            gathers = gathers + ", "
        }

        gathers = gathers + toLowerCase(statName(zone.spots[s].id)) + " " + rangeOf(zone.spots[s].least, zone.spots[s].most)
    }

    if (gathers != "")
    {
        push(lines, "gathers " + gathers)
    }

    for (var m = 0; m < len(zone.mobs); m = m + 1)
    {
        var mob = byId(walkMobs, zone.mobs[m])
        var said = toLowerCase(mob.name)

        if (mob.packSize > 1)
        {
            said = said + " x" + toString(mob.packSize)
        }

        var leaves = ""

        for (var d = 0; d < len(mob.loot); d = d + 1)
        {
            if (leaves != "")
            {
                leaves = leaves + ", "
            }

            leaves = leaves + toLowerCase(statName(mob.loot[d].id))

            if (mob.loot[d].chance < 100)
            {
                leaves = leaves + " " + toString(mob.loot[d].chance) + "%"
            }
        }

        push(lines, "beast: " + said + " | " + leaves)
    }

    return lines
}

// What is written on a task's bar: its name, its time, what it asks, takes and brings of what
// has no arrow, and the places of the town that make it better (the ones that unlock it are on
// its chip)
fun taskLines(graph, task, folded)
{
    var asks = ""
    var takes = ""
    var brings = ""
    var places = ""
    var unlocks = unlockedBy(graph, task)

    for (var r = 0; r < len(task.needs); r = r + 1)
    {
        var req = task.needs[r]

        if (contain(folded, req.stat) and not has(req, "anyOf"))
        {
            if (asks != "")
            {
                asks = asks + ", "
            }

            asks = asks + toLowerCase(statShortName(req.stat)) + " " + toString(req.needed)
        }
    }

    for (var c = 0; c < len(task.costs); c = c + 1)
    {
        if (takes != "")
        {
            takes = takes + ", "
        }

        takes = takes + toString(task.costs[c].amount) + " " + toLowerCase(statShortName(task.costs[c].stat))
    }

    for (var g = 0; g < len(task.gains); g = g + 1)
    {
        if (contain(folded, task.gains[g].stat))
        {
            if (brings != "")
            {
                brings = brings + " "
            }

            brings = brings + signedText(task.gains[g].amount) + " " + toLowerCase(statShortName(task.gains[g].stat))
        }
    }

    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        var link = graph.links[l]

        // A place and the level it changes the task from; knowing the town is the town's too
        if (link.target == task.node and startsWith(link.stat, "town"))
        {
            var place = statLabel(graph, link.stat)

            if (startsWith(link.stat, "town."))
            {
                place = place + " " + toString(link.level)
            }

            if (indexOf(places, place) < 0 and indexOf(unlocks, place) < 0)
            {
                if (places != "")
                {
                    places = places + ", "
                }

                places = places + place
            }
        }
    }

    var time = task.time

    if (task.lastResort)
    {
        time = toString(task.months) + " mo | once the other classes have closed"
    }

    var lines = [task.name, time]
    var zone = byId(walkZones, task.zone)

    if (zone.id != "")
    {
        push(lines, walkDays(zone))
    }

    if (asks != "")
    {
        push(lines, "asks " + asks)
    }

    if (takes != "")
    {
        push(lines, "takes " + takes)
    }

    if (brings != "")
    {
        push(lines, "brings " + brings)
    }

    if (zone.id != "")
    {
        var found = walkLines(zone)

        for (var n = 0; n < len(found); n = n + 1)
        {
            push(lines, found[n])
        }
    }

    // What it teaches him of a fight: the techniques one of its flags gives
    var taught = ""

    for (var t = 0; t < len(walkTechniques); t = t + 1)
    {
        var teaches = false

        for (var l = 0; l < len(graph.links); l = l + 1)
        {
            var link = graph.links[l]

            if (link.source == task.node and (link.kind == "brings" or link.kind == "later") and inList(walkTechniques[t].knows, link.stat))
            {
                teaches = true
            }
        }

        if (teaches)
        {
            if (taught != "")
            {
                taught = taught + ", "
            }

            taught = taught + walkTechniques[t].name
        }
    }

    if (taught != "")
    {
        push(lines, "in a fight: " + taught)
    }

    if (places != "")
    {
        push(lines, "town: " + places)
    }

    return lines
}

// Where a frame from `left` to `right` stands: under the lowest of the frames over its years
fun frameTop(view, left, right)
{
    var top = view.top

    for (var o = 0; o < len(view.bands); o = o + 1)
    {
        var other = view.bands[o]

        if (other.placed and other.left < right and left < other.right and other.top + other.height + frameGap > top)
        {
            top = other.top + other.height + frameGap
        }
    }

    return top
}

// Sets the frames down, each under the lowest of the frames over its years: the ways into a
// class, then the town, which the tasks of every group lead into, then the groups
fun placeFrames(view)
{
    var order = []

    for (var pass = 0; pass < 3; pass = pass + 1)
    {
        for (var b = 0; b < len(view.bands); b = b + 1)
        {
            var kind = 2

            if (view.bands[b].enters)
            {
                kind = 0
            }

            if (view.bands[b].town)
            {
                kind = 1
            }

            if (kind == pass)
            {
                push(order, view.bands[b])
            }
        }
    }

    for (var b = 0; b < len(order); b = b + 1)
    {
        var band = order[b]

        band.top = frameTop(view, band.left, band.right)
        band.placed = true

        for (var n = 0; n < len(band.items); n = n + 1)
        {
            band.items[n].y = band.top + band.rowTops[band.items[n].row]
        }

        for (var n = 0; n < len(band.places); n = n + 1)
        {
            band.places[n].y = band.top + 28 + band.places[n].row * (band.placeTall + rowGap)
        }

        if (band.top + band.height > view.height)
        {
            view.height = band.top + band.height
        }

        if (band.right > view.width)
        {
            view.width = band.right
        }
    }
}

// The month each task can first be begun, and the month each place of the town is first on its
// page: where they stand on the years. A task's own age is the least of it; it is also after the
// first task that brings a flag it asks for (the town known, the Guild made an enemy). A place
// is after the town is known and after what its `shows` asks. Each waits on the others, so the
// months are settled over a few passes. A level of a place a task asks for does not move the
// task: what the town sells is on the page from the start, and says the level it waits for
fun earliestMonths(graph, folded)
{
    var starts = {}
    var byNode = {}

    for (var i = 0; i < len(graph.tasks); i = i + 1)
    {
        byNode[graph.tasks[i].node] = graph.tasks[i]
        starts[graph.tasks[i].node] = startMonth(graph, graph.tasks[i])
    }

    for (var t = 0; t < len(townPlaces); t = t + 1)
    {
        starts[statNode("town." + townPlaces[t].id)] = 0
    }

    for (var pass = 0; pass < 8; pass = pass + 1)
    {
        var moved = false

        for (var i = 0; i < len(graph.tasks); i = i + 1)
        {
            var task = graph.tasks[i]
            var month = starts[task.node]

            // A work of the town is drawn with its place
            if (task.raises != "")
            {
                continue
            }

            for (var l = 0; l < len(graph.links); l = l + 1)
            {
                var link = graph.links[l]

                if (link.target != task.node or link.kind != "asks")
                {
                    continue
                }

                // A flag: once the first task that brings it is over. A skill has many, and its own age says it
                if (contain(folded, link.stat) or startsWith(link.stat, "town."))
                {
                    continue
                }

                var given = -1

                for (var b = 0; b < len(graph.links); b = b + 1)
                {
                    var brings = graph.links[b]

                    if (brings.target == link.source and brings.kind == "brings" and contain(byNode, brings.source))
                    {
                        if (given < 0 or starts[brings.source] + byNode[brings.source].months < given)
                        {
                            given = starts[brings.source] + byNode[brings.source].months
                        }
                    }
                }

                if (given > month)
                {
                    month = given
                }
            }

            if (month != starts[task.node])
            {
                starts[task.node] = month
                moved = true
            }
        }

        for (var t = 0; t < len(townPlaces); t = t + 1)
        {
            var place = townPlaces[t]
            var node = statNode("town." + place.id)
            var shows = lookup(place, "shows", {})
            var month = 0

            for (var l = 0; l < len(graph.links); l = l + 1)
            {
                var link = graph.links[l]

                if (not contain(byNode, link.source) or link.kind != "brings")
                {
                    continue
                }

                var over = starts[link.source] + byNode[link.source].months

                // The town known, and the flag the place asks for: the first task that gives it
                if (link.stat == "town_known" and over > month)
                {
                    month = over
                }
            }

            if (has(shows, "flag"))
            {
                var first = -1

                for (var l = 0; l < len(graph.links); l = l + 1)
                {
                    var link = graph.links[l]

                    if (link.target == statNode(shows.flag) and link.kind == "brings" and contain(byNode, link.source))
                    {
                        if (first < 0 or starts[link.source] + byNode[link.source].months < first)
                        {
                            first = starts[link.source] + byNode[link.source].months
                        }
                    }
                }

                if (first > month)
                {
                    month = first
                }
            }

            if (has(shows, "done"))
            {
                if (contain(byNode, taskNode(shows.done)))
                {
                    if (starts[taskNode(shows.done)] + byNode[taskNode(shows.done)].months > month)
                    {
                        month = starts[taskNode(shows.done)] + byNode[taskNode(shows.done)].months
                    }
                }
            }

            if (lookup(shows, "fromAge", 0) * 12 > month)
            {
                month = shows.fromAge * 12
            }

            if (month != starts[node])
            {
                starts[node] = month
                moved = true
            }
        }

        if (not moved)
        {
            break
        }
    }

    return starts
}

// The town's frame, set on the years like any other: a place is a box that begins the month
// the task that brings it onto the Town page is over (its `shows`: a task done, or the task that
// gives the flag it asks for), and never before the town is known (`earliestMonths`). Its three
// works are bars end to end, each as wide as its months, over what each asks and gives
fun layoutTown(graph, view)
{
    var band = {group: "The town", heading: "THE TOWN", items: [], places: [], rowTops: [], placeTall: 0, placed: false, left: 0, right: 0, top: 0, height: 0, path: "", enters: false, town: true, walk: false}

    // What opens it: the task that makes the town known
    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        if (graph.links[l].stat == "town_known" and graph.links[l].kind == "brings" and contain(view.items, graph.links[l].source))
        {
            band.heading = band.heading + "  -  opened by " + view.items[graph.links[l].source].task.name
        }
    }

    var tall = 0

    for (var t = 0; t < len(townPlaces); t = t + 1)
    {
        var place = townPlaces[t]
        var box = {key: "town." + place.id, name: place.name, found: "", works: [], lines: [], x: 0, y: 0, wide: 0, tall: 0, row: 0, chips: [], lead: 0}
        var bars = 0

        // What brings it onto the page, said beside its name
        var shows = lookup(place, "shows", {})
        var found = []

        if (has(shows, "flag"))
        {
            push(found, "who is: " + statName(shows.flag))
        }

        if (has(shows, "done"))
        {
            push(found, "who has done: " + byId(activities, shows.done).name)
        }

        if (has(shows, "lives"))
        {
            push(found, "life " + toString(shows.lives) + " of the world")
        }

        if (has(shows, "fromAge"))
        {
            push(found, "age " + toString(shows.fromAge))
        }

        box.found = "there once the town is known"

        for (var f = 0; f < len(found); f = f + 1)
        {
            if (f == 0)
            {
                box.found = "found by " + found[f]
            }
            else
            {
                box.found = box.found + ", " + found[f]
            }
        }

        for (var l = 0; l < len(place.levels); l = l + 1)
        {
            var step = place.levels[l]
            var months = step.months + lookup(step, "years", 0) * 12
            var time = toString(step.months) + " mo"

            if (lookup(step, "years", 0) > 0)
            {
                time = time + " and " + toString(step.years) + " years of his life"
            }

            var asked = toString(step.coin) + " coin"
            var also = listOf(step, "costs")

            for (var c = 0; c < len(also); c = c + 1)
            {
                asked = asked + ", " + toString(also[c].amount) + " " + toLowerCase(statShortName(also[c].stat))
            }

            var bar = months * monthWidth

            if (bar < 14)
            {
                bar = 14
            }

            push(box.works, {bar: bar, months: months})
            push(box.lines, toString(l + 1) + ": " + step.work + " | " + time + " | " + asked)
            push(box.lines, "     " + step.gives)

            bars = bars + bar
        }

        box.wide = bars

        if (strlen(box.name) * (letterWidth + 1) + 14 + strlen(box.found) * letterWidth > box.wide)
        {
            box.wide = strlen(box.name) * (letterWidth + 1) + 14 + strlen(box.found) * letterWidth
        }

        for (var n = 0; n < len(box.lines); n = n + 1)
        {
            if (strlen(box.lines[n]) * letterWidth + 8 > box.wide)
            {
                box.wide = strlen(box.lines[n]) * letterWidth + 8
            }
        }

        box.x = view.left + (view.starts[statNode(box.key)] - view.firstMonth) * monthWidth
        box.tall = 20 + 18 + len(box.lines) * lineHeight + 6

        // The walks that bring what its works are built of: chips before it, under its name
        var works = []

        for (var l = 0; l < len(place.levels); l = l + 1)
        {
            push(works, taskNode("raise." + place.id + "." + toString(l + 1)))
        }

        box.chips = walkChips(graph, works, true)

        for (var c = 0; c < len(box.chips); c = c + 1)
        {
            if (box.chips[c].wide + chipGap > box.lead)
            {
                box.lead = box.chips[c].wide + chipGap
            }
        }

        if (20 + len(box.chips) * chipTall + 2 > box.tall)
        {
            box.tall = 20 + len(box.chips) * chipTall + 2
        }

        if (box.tall > tall)
        {
            tall = box.tall
        }

        // Kept in the order they are found in
        var at = len(band.places)

        push(band.places, box)

        while (at > 0 and band.places[at - 1].x > band.places[at].x)
        {
            var swapped = band.places[at - 1]

            band.places[at - 1] = band.places[at]
            band.places[at] = swapped
            at = at - 1
        }
    }

    if (len(band.places) == 0)
    {
        return
    }

    // Each on the first row that is free where it begins
    var rowEnds = []

    band.left = band.places[0].x - framePad

    for (var n = 0; n < len(band.places); n = n + 1)
    {
        if (band.places[n].x - band.places[n].lead - framePad < band.left)
        {
            band.left = band.places[n].x - band.places[n].lead - framePad
        }
    }

    band.right = band.left + strlen(band.heading) * 10 + 20

    for (var n = 0; n < len(band.places); n = n + 1)
    {
        var box = band.places[n]
        var row = -1

        for (var r = 0; r < len(rowEnds); r = r + 1)
        {
            if (row < 0 and rowEnds[r] + 14 <= box.x - box.lead)
            {
                row = r
            }
        }

        if (row < 0)
        {
            row = len(rowEnds)
            push(rowEnds, 0)
        }

        rowEnds[row] = box.x + box.wide
        box.row = row

        if (box.x + box.wide + framePad > band.right)
        {
            band.right = box.x + box.wide + framePad
        }
    }

    band.height = 28 + len(rowEnds) * (tall + rowGap)
    band.placeTall = tall

    for (var n = 0; n < len(band.places); n = n + 1)
    {
        view.places[statNode(band.places[n].key)] = band.places[n]
    }

    push(view.bands, band)
}

// Where everything stands: a frame a group, the ways into a class first, and in each frame its
// tasks on as few rows as hold them without one covering another. A frame is as wide as its
// tasks; `placeFrames` then sets each as high as the frames over its own years allow, so the
// groups of a childhood and the groups of a class share the same height of the page
fun layoutTimeline(graph, folded, left)
{
    var view = {left: left, top: 64, firstMonth: lastAge * 12, lastMonth: (lastAge + 1) * 12, bands: [], items: {}, places: {}, starts: earliestMonths(graph, folded), width: 0, height: 0}

    for (var i = 0; i < len(graph.tasks); i = i + 1)
    {
        if (graph.tasks[i].raises == "" and graph.tasks[i].fromAge * 12 < view.firstMonth)
        {
            // The axis begins at a birthday
            view.firstMonth = graph.tasks[i].fromAge * 12
        }
    }

    // The group of the ways into a class, then the others as the table orders them
    var order = []

    for (var pass = 0; pass < 2; pass = pass + 1)
    {
        for (var g = 0; g < len(graph.groups); g = g + 1)
        {
            var enters = false

            for (var i = 0; i < len(graph.tasks); i = i + 1)
            {
                if (graph.tasks[i].group == graph.groups[g] and (graph.tasks[i].enters or graph.tasks[i].calling != ""))
                {
                    enters = true
                }
            }

            if (enters == (pass == 0))
            {
                push(order, graph.groups[g])
            }
        }
    }

    for (var b = 0; b < len(order); b = b + 1)
    {
        var band = {group: order[b], heading: toUpperCase(order[b]), items: [], places: [], rowTops: [], placeTall: 0, placed: false, left: 0, right: 0, top: 0, height: 0, path: "", enters: false, town: false, walk: false}
        var mixed = false

        for (var i = 0; i < len(graph.tasks); i = i + 1)
        {
            var task = graph.tasks[i]

            if (task.group != order[b] or task.raises != "")
            {
                continue
            }

            var lines = taskLines(graph, task, folded)
            var start = view.starts[task.node]
            var x = view.left + (start - view.firstMonth) * monthWidth
            var bar = task.months * monthWidth

            // What is done at once still has a bar to hold its stripe
            if (bar < 6)
            {
                bar = 6
            }

            // As wide as its longest line, the name in a heavier face
            var wide = strlen(lines[0]) * (letterWidth + 1)

            for (var n = 1; n < len(lines); n = n + 1)
            {
                if (strlen(lines[n]) * letterWidth > wide)
                {
                    wide = strlen(lines[n]) * letterWidth
                }
            }

            // The age it must be over by, when it has one before old age
            var over = 0

            if (task.finishBy < lastAge)
            {
                over = view.left + (task.byMonth - view.firstMonth) * monthWidth
            }

            var reach = x + bar

            if (x + wide + 12 > reach)
            {
                reach = x + wide + 12
            }

            // Its bar and its text, then with the line after them
            var body = reach

            if (over > reach)
            {
                reach = over
            }

            var item = {task: task, lines: lines, start: start, x: x, bar: bar, over: over, body: body, reach: reach, row: 0, y: 0, tall: len(lines) * lineHeight + 8, chips: walkChips(graph, [task.node], false), lead: 0}

            // The level of the town it waits for stands before it, on a chip, over the walks
            // that bring what it takes
            var waits = unlockedBy(graph, task)

            if (waits != "")
            {
                insert(item.chips, 0, {text: waits, wide: strlen(waits) * letterWidth + 12, walk: false})
            }

            for (var c = 0; c < len(item.chips); c = c + 1)
            {
                if (item.chips[c].wide + chipGap > item.lead)
                {
                    item.lead = item.chips[c].wide + chipGap
                }
            }

            if (len(item.chips) * chipTall + 2 > item.tall)
            {
                item.tall = len(item.chips) * chipTall + 2
            }

            // The classes it leads to stand after it, on chips: room for them, and for the line
            // that runs under them to the age it closes at
            item.tails = classChips(graph, task, folded)
            item.tailEnd = item.body

            for (var c = 0; c < len(item.tails); c = c + 1)
            {
                if (item.body + chipGap + item.tails[c].wide > item.tailEnd)
                {
                    item.tailEnd = item.body + chipGap + item.tails[c].wide
                }
            }

            if (item.tailEnd > item.reach)
            {
                item.reach = item.tailEnd
            }

            if (len(item.tails) * chipTall + 10 > item.tall and len(item.tails) > 0)
            {
                item.tall = len(item.tails) * chipTall + 10
            }

            if (task.zone != "")
            {
                band.walk = true
            }

            if (task.enters or task.calling != "")
            {
                band.enters = true
            }
            else if (len(band.items) == 0 and not mixed)
            {
                band.path = task.path
            }
            else if (task.path != band.path)
            {
                band.path = ""
                mixed = true
            }

            // Kept in the order they open in
            var at = len(band.items)

            push(band.items, item)

            while (at > 0 and band.items[at - 1].x > band.items[at].x)
            {
                var swapped = band.items[at - 1]

                band.items[at - 1] = band.items[at]
                band.items[at] = swapped
                at = at - 1
            }
        }

        if (len(band.items) == 0)
        {
            continue
        }

        // Each on the first row that is free where it begins; a row is as tall as its tallest bar
        var rowEnds = []
        var rowTalls = []

        for (var n = 0; n < len(band.items); n = n + 1)
        {
            var item = band.items[n]
            var row = -1

            for (var r = 0; r < len(rowEnds); r = r + 1)
            {
                if (row < 0 and rowEnds[r] + 14 <= item.x - item.lead)
                {
                    row = r
                }
            }

            if (row < 0)
            {
                row = len(rowEnds)
                push(rowEnds, 0)
                push(rowTalls, 0)
            }

            rowEnds[row] = item.reach
            item.row = row
            view.items[item.task.node] = item

            if (item.tall > rowTalls[row])
            {
                rowTalls[row] = item.tall
            }

            if (item.reach > view.width)
            {
                view.width = item.reach
            }
        }

        var rowTops = []
        var under = 28

        for (var r = 0; r < len(rowTalls); r = r + 1)
        {
            push(rowTops, under)
            under = under + rowTalls[r] + rowGap
        }

        band.height = under

        // A group all of one class says which way in opens it; all of one second calling, that
        // calling's own way in
        var under = band.items[0].task.under

        for (var n = 0; n < len(band.items); n = n + 1)
        {
            if (band.items[n].task.under != under)
            {
                under = ""
            }
        }

        if (under != "")
        {
            band.heading = band.heading + "  -  opened by " + graph.callings[under]
        }
        else if (band.path != "" and not band.enters)
        {
            for (var i = 0; i < len(graph.tasks); i = i + 1)
            {
                if (graph.tasks[i].enters and graph.tasks[i].path == band.path)
                {
                    band.heading = band.heading + "  -  opened by " + graph.tasks[i].name
                }
            }
        }

        // As wide as its tasks, and as its heading. A line that runs to an age ends a little past
        // the frame: the frame of the group that opens at that age begins there, and the two
        // stand side by side
        band.left = band.items[0].x - framePad

        for (var n = 0; n < len(band.items); n = n + 1)
        {
            if (band.items[n].x - band.items[n].lead - framePad < band.left)
            {
                band.left = band.items[n].x - band.items[n].lead - framePad
            }
        }

        band.right = band.left + strlen(band.heading) * 10 + 20

        for (var n = 0; n < len(band.items); n = n + 1)
        {
            if (band.items[n].tailEnd + framePad > band.right)
            {
                band.right = band.items[n].tailEnd + framePad
            }

            if (band.items[n].over - framePad > band.right)
            {
                band.right = band.items[n].over - framePad
            }
        }

        band.rowTops = rowTops

        push(view.bands, band)
    }

    layoutTown(graph, view)
    placeFrames(view)

    var axis = view.left + (view.lastMonth - view.firstMonth) * monthWidth

    if (axis > view.width)
    {
        view.width = axis
    }

    view.width = view.width + 24
    view.height = view.height + 40

    return view
}

// The colour of a class, "" for none
fun classColour(path)
{
    for (var p = 0; p < len(paths); p = p + 1)
    {
        if (paths[p].id == path)
        {
            return classColours[p % len(classColours)]
        }
    }

    return ""
}

// One of the town's arrows, with what it says at its middle. To a point that is not after its
// start on the years it leaves upward and comes in from the left
fun townArrow(x1, y1, x2, y2, label)
{
    var bend = toInt(floor((x2 - x1) / 2))
    var curve = ""

    if (bend < 60)
    {
        bend = 60
    }

    if (x2 > x1 - 8)
    {
        curve = "M " + toString(x1) + " " + toString(y1) + " C " + toString(x1 + bend) + " " + toString(y1) + ", " + toString(x2 - bend) + " " + toString(y2) + ", " + toString(x2) + " " + toString(y2)
    }
    else
    {
        curve = "M " + toString(x1) + " " + toString(y1) + " C " + toString(x1) + " " + toString(y1 - 120) + ", " + toString(x2 - 90) + " " + toString(y2) + ", " + toString(x2) + " " + toString(y2)
    }

    var out = "<path d='" + curve + "' fill='none' stroke='" + townColour + "' stroke-width='1.8' marker-end='url(#shows)'/>\n"

    return out + "<text x='" + toString(toInt(floor((x1 + x2) / 2))) + "' y='" + toString(toInt(floor((y1 + y2) / 2)) - 4) + "' text-anchor='middle' class='flag' style='fill: " + townColour + "'>" + xmlText(label) + "</text>\n"
}

// The SVG text of the timeline
fun emitTimeline(graph)
{
    var folded = foldedStats(graph)
    var view = layoutTimeline(graph, folded, 24)

    // A chip before a bar of the first months would stand off the page: everything is set
    // again, further right
    var least = view.left

    for (var b = 0; b < len(view.bands); b = b + 1)
    {
        if (view.bands[b].left < least)
        {
            least = view.bands[b].left
        }
    }

    if (least < 12)
    {
        view = layoutTimeline(graph, folded, 24 + 12 - least)
    }

    var out = "<svg xmlns='http://www.w3.org/2000/svg' width='" + toString(view.width) + "' height='" + toString(view.height) + "' viewBox='0 0 " + toString(view.width) + " " + toString(view.height) + "'>\n"

    out = out + "<style>\n"
    out = out + "text { font-family: Helvetica, Arial, sans-serif; font-size: 11px; fill: #1a202c; }\n"
    out = out + ".name { font-weight: bold; font-size: 12px; }\n"
    out = out + ".band { font-weight: bold; font-size: 15px; }\n"
    out = out + ".age { font-weight: bold; font-size: 13px; fill: #4a5568; }\n"
    out = out + ".note { fill: #4a5568; }\n"
    out = out + ".flag { font-size: 10px; paint-order: stroke; stroke: #ffffff; stroke-width: 3px; }\n"
    out = out + "</style>\n"
    out = out + "<defs>\n"
    out = out + "<marker id='asks' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M 0 0 L 10 5 L 0 10 z' fill='#1a202c'/></marker>\n"
    out = out + "<marker id='eases' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M 0 0 L 10 5 L 0 10 z' fill='#2f855a'/></marker>\n"
    out = out + "<marker id='shows' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M 0 0 L 10 5 L 0 10 z' fill='" + townColour + "'/></marker>\n"
    out = out + "<marker id='walks' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M 0 0 L 10 5 L 0 10 z' fill='" + walkColour + "'/></marker>\n"

    for (var p = 0; p < len(paths); p = p + 1)
    {
        out = out + "<marker id='way" + toString(p) + "' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M 0 0 L 10 5 L 0 10 z' fill='" + classColour(paths[p].id) + "'/></marker>\n"
    }

    out = out + "</defs>\n"
    out = out + "<rect width='" + toString(view.width) + "' height='" + toString(view.height) + "' fill='#ffffff'/>\n"
    out = out + "<text x='" + toString(view.left) + "' y='20' class='note'>A bar: the months a task takes, from the age it opens at. The line after it: the age it must be over by. Gold: a way into a class; a stripe: a task of that class. An arrow: a flag one task brings and another reads (black asks for it, dashed green is eased by it or takes it as one of several). Purple: the town. A place begins where the task that brings it onto the page ends, its three works bars end to end, with an arrow from that task. A purple chip before a task: the level of a place it waits for.</text>\n"
    out = out + "<text x='" + toString(view.left) + "' y='34' class='note'>Red: a walk outside the town, with its days, what is gathered there and its beasts (what each leaves). A red chip before a task or a place of the town: the walks that bring what it takes; what is sold or brewed of a thing begins once the first walk that brings it is over. \"in a fight\" on a bar: the technique the task teaches, for the walks that have a beast. A gold chip after a task: the class it leads to, and what it changes of what that class asks; no arrow climbs to the ways in.</text>\n"

    // The frames, a group each, in the colour of its class when it is all of one
    for (var b = 0; b < len(view.bands); b = b + 1)
    {
        var band = view.bands[b]
        var colour = "#a0aec0"

        if (band.path != "" and not band.enters)
        {
            colour = classColour(band.path)
        }

        if (band.town)
        {
            colour = townColour
        }

        if (band.walk)
        {
            colour = walkColour
        }

        out = out + "<rect x='" + toString(band.left) + "' y='" + toString(band.top) + "' width='" + toString(band.right - band.left) + "' height='" + toString(band.height) + "' rx='8' fill='#f7fafc' stroke='" + colour + "' stroke-width='1.5'/>\n"
    }

    // The years
    for (var month = view.firstMonth; month <= view.lastMonth; month = month + 12)
    {
        var x = view.left + (month - view.firstMonth) * monthWidth
        var year = toInt(floor(month / 12))

        out = out + "<line x1='" + toString(x) + "' y1='" + toString(view.top - 8) + "' x2='" + toString(x) + "' y2='" + toString(view.height - 24) + "' stroke='#cbd5e0' stroke-width='1'/>\n"
        out = out + "<text x='" + toString(x + 4) + "' y='" + toString(view.top - 12) + "' class='age'>AGE " + toString(year) + "</text>\n"
        out = out + "<text x='" + toString(x + 4) + "' y='" + toString(view.height - 10) + "' class='age'>AGE " + toString(year) + "</text>\n"
    }

    // The bars
    for (var b = 0; b < len(view.bands); b = b + 1)
    {
        var band = view.bands[b]
        var colour = "#1a202c"

        if (band.path != "" and not band.enters)
        {
            colour = classColour(band.path)
        }

        if (band.town)
        {
            colour = townColour
        }

        if (band.walk)
        {
            colour = walkColour
        }

        out = out + "<text x='" + toString(band.left + 10) + "' y='" + toString(band.top + 19) + "' class='band' style='fill: " + colour + "'>" + xmlText(band.heading) + "</text>\n"

        // A place: its name, its works as bars end to end, then what each asks and gives
        for (var n = 0; n < len(band.places); n = n + 1)
        {
            var box = band.places[n]
            var at = box.x

            out = out + emitChips(box.chips, box.x, box.y + 22)
            out = out + "<rect x='" + toString(box.x) + "' y='" + toString(box.y) + "' width='" + toString(box.wide) + "' height='" + toString(box.tall) + "' rx='4' fill='#ffffff' stroke='" + townColour + "' stroke-width='1'/>\n"
            out = out + "<text x='" + toString(box.x + 4) + "' y='" + toString(box.y + 15) + "' class='name'>" + xmlText(box.name) + "</text>\n"
            out = out + "<text x='" + toString(box.x + 14 + strlen(box.name) * (letterWidth + 1)) + "' y='" + toString(box.y + 15) + "' class='note' style='fill: " + townColour + "'>" + xmlText(box.found) + "</text>\n"

            for (var w = 0; w < len(box.works); w = w + 1)
            {
                out = out + "<rect x='" + toString(at) + "' y='" + toString(box.y + 21) + "' width='" + toString(box.works[w].bar) + "' height='14' fill='" + workColours[w % len(workColours)] + "' stroke='" + townColour + "' stroke-width='1'/>\n"
                out = out + "<text x='" + toString(at + 4) + "' y='" + toString(box.y + 32) + "' class='note'>" + toString(w + 1) + "</text>\n"

                at = at + box.works[w].bar
            }

            for (var l = 0; l < len(box.lines); l = l + 1)
            {
                out = out + "<text x='" + toString(box.x + 4) + "' y='" + toString(box.y + 50 + l * lineHeight) + "' class='note'>" + xmlText(box.lines[l]) + "</text>\n"
            }
        }

        for (var n = 0; n < len(band.items); n = n + 1)
        {
            var item = band.items[n]
            var task = item.task
            var fill = "#dbe4f0"
            var edge = "#a0aec0"
            var edgeWidth = "1"
            var stripe = classColour(task.path)

            if (task.enters or task.calling != "")
            {
                fill = "#f6e05e"
                edge = stripe
                edgeWidth = "3"
            }

            if (task.zone != "")
            {
                fill = walkFill
                edge = walkColour
            }

            // What it waits for: its chips before it, each with a short arrow
            out = out + emitChips(item.chips, item.x, item.y + 3)
            out = out + emitTails(item.tails, item.body, item.y + 3)

            // Until when it must be over
            if (item.over > item.x + item.bar)
            {
                var y = item.y + item.tall - 4

                out = out + "<line x1='" + toString(item.x + item.bar) + "' y1='" + toString(y) + "' x2='" + toString(item.over) + "' y2='" + toString(y) + "' stroke='#a0aec0' stroke-width='2'/>\n"
                out = out + "<line x1='" + toString(item.over) + "' y1='" + toString(y - 6) + "' x2='" + toString(item.over) + "' y2='" + toString(y + 6) + "' stroke='#a0aec0' stroke-width='2'/>\n"
            }

            out = out + "<rect x='" + toString(item.x) + "' y='" + toString(item.y) + "' width='" + toString(item.bar) + "' height='" + toString(item.tall) + "' rx='4' fill='" + fill + "' stroke='" + edge + "' stroke-width='" + edgeWidth + "'/>\n"

            if (stripe != "" and not task.enters and task.calling == "")
            {
                out = out + "<rect x='" + toString(item.x) + "' y='" + toString(item.y) + "' width='5' height='" + toString(item.tall) + "' fill='" + stripe + "'/>\n"
            }

            for (var l = 0; l < len(item.lines); l = l + 1)
            {
                var kind = "note"

                if (l == 0)
                {
                    kind = "name"
                }

                out = out + "<text x='" + toString(item.x + 9) + "' y='" + toString(item.y + 15 + l * lineHeight) + "' class='" + kind + "'>" + xmlText(item.lines[l]) + "</text>\n"
            }
        }
    }

    // The town's arrows, like a flag's: into a place, from where the task that brings it onto
    // the page ends (a task done, or each task that gives the flag it asks for). None comes out
    // of the town: a task a level unlocks has its chip, one a level makes better says so on its bar
    var drawn = {}

    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        var link = graph.links[l]

        if (link.kind == "shows" and contain(view.places, link.target))
        {
            // The task itself, or every task that gives the flag
            var givers = []
            var label = "done once"

            if (startsWith(link.source, "task/"))
            {
                push(givers, link.source)
            }
            else
            {
                label = statLabel(graph, link.stat)

                for (var b = 0; b < len(graph.links); b = b + 1)
                {
                    if (graph.links[b].target == link.source and startsWith(graph.links[b].source, "task/"))
                    {
                        push(givers, graph.links[b].source)
                    }
                }
            }

            for (var g = 0; g < len(givers); g = g + 1)
            {
                if (contain(view.items, givers[g]))
                {
                    var task = view.items[givers[g]]
                    var place = view.places[link.target]
                    var into = place.y + toInt(floor(place.tall / 2))

                    // Over the chips of a place that has some
                    if (len(place.chips) > 0)
                    {
                        into = place.y + 10
                    }

                    out = out + townArrow(task.x + task.bar, task.y + toInt(floor(task.tall / 2)), place.x - 2, into, label)
                }
            }
        }

    }

    drawn = {}

    // The arrows: a flag, from where the task that brings it ends to where the one that reads it
    // begins. None for a thing a walk brings home: what takes it has the walks on a chip

    for (var s = 0; s < len(graph.stats); s = s + 1)
    {
        var stat = graph.stats[s]

        if (contain(folded, stat) or startsWith(stat, "town") or contain(graph.things, stat))
        {
            continue
        }

        for (var b = 0; b < len(graph.links); b = b + 1)
        {
            var brings = graph.links[b]

            if (brings.target != statNode(stat) or not contain(view.items, brings.source))
            {
                continue
            }

            for (var r = 0; r < len(graph.links); r = r + 1)
            {
                var reads = graph.links[r]

                if (reads.source != statNode(stat) or not contain(view.items, reads.target) or reads.kind == "classOf" or reads.kind == "uses" or reads.target == brings.source)
                {
                    continue
                }

                if (contain(drawn, brings.source + ">" + reads.target + ">" + stat))
                {
                    continue
                }

                // None into a way into a class: the task that leads there has the class on a chip
                if ((view.items[reads.target].task.enters or view.items[reads.target].task.calling != "") and classIndex(view.items[reads.target].task.path) >= 0)
                {
                    continue
                }

                drawn[brings.source + ">" + reads.target + ">" + stat] = true

                var first = view.items[brings.source]
                var second = view.items[reads.target]
                var x1 = first.x + first.bar
                var y1 = first.y + toInt(floor(first.tall / 2))
                var x2 = second.x - 2
                var y2 = second.y + toInt(floor(second.tall / 2))
                var bend = toInt(floor((x2 - x1) / 2))

                if (bend < 60)
                {
                    bend = 60
                }

                var label = statLabel(graph, stat)
                var colour = "#1a202c"
                var marker = "asks"
                var dash = ""

                if (reads.kind == "asks")
                {
                    if (reads.label != "1")
                    {
                        label = label + " " + reads.label
                    }
                }
                else
                {
                    label = label + " (" + reads.label + ")"
                    colour = "#2f855a"
                    marker = "eases"
                    dash = " stroke-dasharray='6 4'"
                }

                if (brings.kind == "later")
                {
                    label = label + " [" + brings.label + "]"
                }

                out = out + "<path d='M " + toString(x1) + " " + toString(y1) + " C " + toString(x1 + bend) + " " + toString(y1) + ", " + toString(x2 - bend) + " " + toString(y2) + ", " + toString(x2) + " " + toString(y2) + "' fill='none' stroke='" + colour + "' stroke-width='1.6'" + dash + " marker-end='url(#" + marker + ")'/>\n"
                out = out + "<text x='" + toString(toInt(floor((x1 + x2) / 2))) + "' y='" + toString(toInt(floor((y1 + y2) / 2)) - 4) + "' text-anchor='middle' class='flag' style='fill: " + colour + "'>" + xmlText(label) + "</text>\n"
            }
        }
    }

    return out + "</svg>\n"
}

// What is asked for and brought by nothing, and what is brought and read by no task
// What is asked for and brought by nothing, and what is brought and read by nothing: {missing,
// unread}, the keys of stats
fun looseEnds(graph)
{
    var brought = {}
    var read = {}

    for (var l = 0; l < len(graph.links); l = l + 1)
    {
        var link = graph.links[l]

        if (inList(bringKinds, link.kind))
        {
            brought[link.stat] = true
        }

        if (inList(readKinds, link.kind))
        {
            read[link.stat] = true
        }
    }

    // The most a stat can be goes with the stat (lib.pg's `statCaps`): born with, like it
    var born = []

    for (var b = 0; b < len(bornWith); b = b + 1)
    {
        push(born, bornWith[b])
        push(born, capOf(bornWith[b]))
    }

    var ends = {missing: [], unread: []}

    for (var s = 0; s < len(graph.stats); s = s + 1)
    {
        var stat = graph.stats[s]

        // (a technique of a fight is taught by a flag, not brought by a task)
        if (contain(read, stat) and not contain(brought, stat) and not inList(born, stat) and not startsWith(stat, "fight."))
        {
            push(ends.missing, stat)
        }

        if (contain(brought, stat) and not contain(read, stat) and not inList(born, stat))
        {
            push(ends.unread, stat)
        }
    }

    return ends
}

fun printLooseEnds(graph)
{
    var ends = looseEnds(graph)
    var missing = ""
    var unread = ""

    for (var m = 0; m < len(ends.missing); m = m + 1)
    {
        missing = missing + "  " + ends.missing[m] + "\n"
    }

    for (var u = 0; u < len(ends.unread); u = u + 1)
    {
        unread = unread + "  " + ends.unread[u] + "\n"
    }

    if (missing != "")
    {
        print("Asked for, brought by nothing:\n" + missing)
    }

    if (unread != "")
    {
        print("Brought, read by no task and no place (a milestone, a deed or the epitaph may read it):\n" + unread)
    }
}

// The graph's facts, for the solver (--facts <file>): a line a task, "task|id|begin|end|by", the
// month of his age it can be begun at the earliest, the month it is over then (the timeline's
// bars: its age, the flags it asks for once the first task that brings each is over; a work of
// the town once its place is on the page, after the works before it), and the month it must be
// over by. Then "missing|stat" a line for what is asked and brought by nothing, "unread|stat"
// for what is brought and read by nothing
fun writeFacts(graph, file)
{
    var starts = earliestMonths(graph, foldedStats(graph))
    var lines = []

    for (var i = 0; i < len(graph.tasks); i = i + 1)
    {
        var task = graph.tasks[i]
        var begin = starts[task.node]

        if (task.raises != "")
        {
            var place = byId(townPlaces, task.raises)
            var parts = split(task.id, ".")
            var level = toInt(parts[len(parts) - 1])

            begin = starts[statNode("town." + task.raises)]

            for (var l = 0; l < level - 1 and l < len(place.levels); l = l + 1)
            {
                begin = begin + place.levels[l].months + lookup(place.levels[l], "years", 0) * 12
            }
        }

        push(lines, "task|" + task.id + "|" + toString(begin) + "|" + toString(begin + task.months) + "|" + toString(task.byMonth))
    }

    var ends = looseEnds(graph)

    for (var m = 0; m < len(ends.missing); m = m + 1)
    {
        push(lines, "missing|" + ends.missing[m])
    }

    for (var u = 0; u < len(ends.unread); u = u + 1)
    {
        push(lines, "unread|" + ends.unread[u])
    }

    writeFile(file, join(lines, "\n"))
}

// ============================================================================
// Main
// ============================================================================

fun main()
{
    if (getArgCount() > 4)
    {
        print("Usage: PgCompilerBootstrap examples/Chronicle/rules/depgraph.pg [out.svg]")
        print("       PgCompilerBootstrap examples/Chronicle/rules/depgraph.pg <out.dot> <focus>")

        return
    }

    if (len(errors) > 0)
    {
        print("The activity table refuses itself: " + errors[0])

        return
    }

    // The facts alone, for the solver
    if (getArgCount() == 4 and getArg(2) == "--facts")
    {
        writeFacts(buildGraph(), getArg(3))
        print("Wrote the graph's facts to " + getArg(3))

        return
    }

    var outFile = "chronicle-graph.svg"
    var focus = ""

    if (getArgCount() > 3)
    {
        outFile = "chronicle-graph.dot"
        focus = getArg(3)
    }

    if (getArgCount() > 2)
    {
        outFile = getArg(2)
    }

    if (len(errors) > 0)
    {
        print("The activity table refuses itself: " + errors[0])

        return
    }

    var graph = buildGraph()
    var kept = {}
    var focusNode = ""
    var text = ""

    if (focus == "")
    {
        text = emitTimeline(graph)
    }
    else if (focus == "all")
    {
        text = emitDot(graph, kept, "")
    }
    else
    {
        if (contain(graph.taskIds, focus))
        {
            focusNode = taskNode(focus)
        }
        else if (contain(graph.statKeys, focus))
        {
            focusNode = statNode(focus)
        }
        else
        {
            print("No task and no stat is called '" + focus + "'")

            return
        }

        // From a task, its stats and the tasks on their other side; from a stat, its tasks
        var steps = 1

        if (contain(graph.taskIds, focus))
        {
            steps = 2
        }

        var before = reachFrom(graph, focusNode, false, steps)
        var after = reachFrom(graph, focusNode, true, steps)

        for (var node : before)
        {
            kept[node] = true
        }

        for (var node : after)
        {
            kept[node] = true
        }

        print(focus + " is fed by: " + taskNames(graph, before, focusNode))
        print(focus + " feeds: " + taskNames(graph, after, focusNode))
        print("")

        text = emitDot(graph, kept, focusNode)
    }

    writeFile(outFile, text)

    print("Wrote " + outFile + ": " + toString(len(graph.tasks)) + " tasks, " + toString(len(graph.stats)) + " stats, " + toString(len(graph.links)) + " links")

    if (focus != "")
    {
        print("Draw it with: dot -Tsvg " + outFile + " -o chronicle-graph.svg")
    }

    print("")

    if (focus == "")
    {
        printLooseEnds(graph)
    }
}

// ============================================================================
// The tables
// ============================================================================

// What the activity table reads: a boy of 7 who holds nothing and has done nothing, so every task
// is as the table writes it (no step of repetition, no bonus, nothing eased)
var age = 7
var world = 0
var lives = 2
var running = ""
var activityId = ""
var done = {}

// (but for the Inn, which stands: the picture is of the whole table, a second calling and the
// years to fifty with it)
var character = {"town.inn": 1}

// The economy's tables: the basics, the familiars and what each kind makes
import "economytable"
import "activitytable"

// A life is born with slots for familiars of its own (economytable.pg's `baseSlots`): what his
// standing and a calling add come later, and nothing has to bring the first
if (economyKnobs.baseSlots > 0)
{
    push(bornWith, "slot")
}

main()
