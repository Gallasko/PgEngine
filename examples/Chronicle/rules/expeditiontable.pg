// What a fight offers besides the four things anyone can do (strike, defend, take a remedy,
// flee): what he has learned in his life, and nothing he has not. A blow is of the body and a
// spell of the mind; both cost breath. `knows` is the flags that teach it (any one of them:
// what a class gives, or a work here and there, activitytable.pg), `where` it is learned,
// as its tile says. `power` and `hit` are against a strike's (percent of its blow, points of its
// chance); a spell's blow is counted from his Intelligence, not from his Strength and Arms.
// `breath: 0` costs nothing, and says nothing of breath: who has learned only that is not told of it.
// `cool` is the turns before it can be used again; `all` strikes every beast standing; `holds`
// deals nothing, and the beast aimed at loses its next move.
const walkTechniques = [
    // A boy's: what the wooden blade taught him, the edge or the point and never both
    // (activitytable.pg's `slashes` and `stabs`). A better way to strike, no more: it costs no
    // breath and waits for nothing (`breath: 0`, `cool: 0`), and is his every turn. A little of
    // each way: more blow for less aim, or more aim for less blow
    {id: "slash", name: "Slash", kind: "blow", breath: 0, cool: 0, power: 130, hit: -10, all: false, holds: false,
     knows: ["slash_learned"], where: "THE WOODEN BLADE", line: "The whole arm behind it: it bites deeper, and misses more"},
    {id: "thrust", name: "Thrust", kind: "blow", breath: 0, cool: 0, power: 90, hit: 15, all: false, holds: false,
     knows: ["thrust_learned"], where: "THE WOODEN BLADE", line: "The point, straight: it seldom misses"},

    // The Keep's: what its sworn men are drilled in, and what a campaign teaches
    {id: "heavy", name: "Heavy cut", kind: "blow", breath: 2, cool: 2, power: 170, hit: -15, all: false, holds: false,
     knows: ["keep_oath", "levy_served"], where: "THE KEEP", line: "A slow, full blow"},
    {id: "sweep", name: "Sweep", kind: "blow", breath: 3, cool: 3, power: 70, hit: 0, all: true, holds: false,
     knows: ["veteran"], where: "THE CAMPAIGN", line: "One blow at every beast standing"},

    // The Collegium's: a first working, and what Magister Orin shows his assistant
    {id: "firebolt", name: "Firebolt", kind: "spell", breath: 2, cool: 1, power: 100, hit: 15, all: false, holds: false,
     knows: ["collegium"], where: "THE COLLEGIUM", line: "A working thrown like a stone: it seldom misses"},
    {id: "binding", name: "Binding word", kind: "spell", breath: 2, cool: 3, power: 0, hit: 0, all: false, holds: true,
     knows: ["orin_known"], where: "MAGISTER ORIN", line: "The beast aimed at is held, and loses its next move"},

    // The smuggler's one trick: a fistful of sand. It costs no breath, and he has to find more
    // sand before the next (`cool`)
    {id: "sand", name: "Sand in the eyes", kind: "blow", breath: 0, cool: 3, power: 0, hit: 0, all: false, holds: true,
     knows: ["smuggler_runner"], where: "THE SMUGGLER", line: "The beast aimed at is blinded, and loses its next move"},

    // Learned here and there: the streets teach it, and so does the Hidden Hand
    {id: "feint", name: "Feint and step", kind: "blow", breath: 1, cool: 1, power: 80, hit: 20, all: false, holds: false,
     knows: ["street_known", "hidden_hand"], where: "THE STREETS", line: "A sure blow, and he is hard to bite after it"},

    // A second calling's: what the Elemental Chair teaches, and the elements a Spellwright has
    // bound that a fight can use (activitytable.pg's `bind`: its third and its fourth)
    {id: "frostbind", name: "Frostbind", kind: "spell", breath: 0, cool: 3, power: 0, hit: 0, all: false, holds: true,
     knows: ["spellwright"], where: "THE ELEMENTAL CHAIR", line: "The beast aimed at is held in frost, and loses its next move"},
    {id: "firebolt2", name: "Firebolt II", kind: "spell", breath: 2, cool: 1, power: 150, hit: 15, all: false, holds: false,
     knows: ["firebolt2_bound"], where: "THE BOUND ELEMENTS", line: "The first working, bound to him: it bites half again as deep"},
    {id: "chain", name: "Chain lightning", kind: "spell", breath: 3, cool: 3, power: 90, hit: 0, all: true, holds: false,
     knows: ["chain_bound"], where: "THE BOUND ELEMENTS", line: "One working through every beast standing"}
]

// `deals` and `takes` are percent of what he deals and of what he takes.
const walkStances = [
    {id: "balanced", name: "Balanced", deals: 100, takes: 100, line: "Neither more nor less"},
    {id: "aggressive", name: "Aggressive", deals: 125, takes: 125, line: "He hits harder and is hit harder"},
    {id: "cautious", name: "Cautious", deals: 80, takes: 70, line: "He hits less hard and is hit less"}
]
