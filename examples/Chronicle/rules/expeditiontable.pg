             circle: {name: "Wheel away", line: "It is gone between the oaks, and back from another side."}},
     script: ["circle", "circle", "bite"], weak: "heavy",
     trains: "dex", xp: 8,
     loot: [{id: "hides", chance: 100, least: 2, most: 2}, {id: "antler", chance: 50, least: 1, most: 1}]},

    {id: "adder", name: "Stone adder", many: "stone adders", pack: "", lone: "", rarity: "uncommon", packSize: 1, holdsBack: 0,
     about: "The colour of the stone it sleeps on.",
     hp: 12, least: 5, most: 9, guard: 0, quick: 12, verb: "strikes",
     moves: {bite: {name: "Strike", line: "Faster than the eye. The bite itself is small."},
             circle: {name: "Coil", line: "It draws back on itself."}},
     script: ["circle", "bite"], weak: "feint",
     trains: "dex", xp: 4,
     loot: [{id: "fangs", chance: 100, least: 1, most: 3}]}
]

