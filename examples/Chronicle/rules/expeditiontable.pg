]

var walkEvents = [
    {id: "hedge.nest", trigger: "gather", weight: 2, once: false,
     title: "A nest in the thorn",
     text: "A blackbird's nest sits deep in the hedge, right where the best berries hang. The bird watches him.",
     options: [
        {id: "reach", label: "Reach past it", ap: 0, hp: -3, items: [{id: "berries", amount: 3}], effects: [],
         line: "Scratched to the elbow"},
        {id: "leave", label: "Leave it be", ap: 0, hp: 0, items: [], effects: [{kind: "study", amount: 1}],
         line: "He watched the bird a while"}
     ]},

    {id: "hedge.keeper", trigger: "study", weight: 1, once: true,
     title: "The hedge keeper",
     text: "An old man is laying the hedge, as his father did. He looks at the boy, then at the boy's hands.",
     options: [
        {id: "help", label: "Help him a day", ap: 1, hp: 0, items: [{id: "firewood", amount: 3}], effects: [{kind: "study", amount: 1}],
         line: "A day with the hedge keeper"},
        {id: "share", label: "Share a ration", ap: 0, hp: 0, items: [{id: "rations", amount: -1}, {id: "wortleaf", amount: 2}], effects: [{kind: "study", amount: 2}],
         line: "Bread for the hedge keeper, and what he knows"},
        {id: "pass", label: "Walk on", ap: 0, hp: 0, items: [], effects: [],
         line: "He left the old man to his work"}
     ]},

    {id: "pond.heron", trigger: "gather", weight: 1, once: false,
     title: "A heron at the weir",
     text: "A heron stands where the fish gather, as still as a post. It has seen him. It has not moved.",
     options: [
        {id: "watch", label: "Watch where it fishes", ap: 1, hp: 0, items: [{id: "fish", amount: 3}], effects: [],
         line: "He fished where the heron did"},
        {id: "chase", label: "Drive it off", ap: 0, hp: 0, items: [{id: "fish", amount: 1}], effects: [{kind: "seek", mob: "rat", amount: -1}],
         line: "The heron left, and the reeds stirred"}
     ]},

    {id: "hollow.hunter", trigger: "seek", weight: 2, once: false,
