         line: "A ration for the hunter, and the Stag's trail"},
        {id: "ask", label: "Ask what he saw", ap: 0, hp: 0, items: [], effects: [{kind: "observe", mob: "wolf", amount: 1}],
         line: "The hunter spoke of the wolves"},
        {id: "pass", label: "Leave him", ap: 0, hp: 0, items: [], effects: [],
         line: "He left the hunter by his fire"}
     ]},

    {id: "hollow.tracks", trigger: "study", weight: 2, once: false,
     title: "Fresh tracks",
     text: "Deep prints cross the path, the mud still wet in them. A boar, heavy, and not long gone.",
     options: [
        {id: "follow", label: "Follow them", ap: 1, hp: 0, items: [], effects: [{kind: "seek", mob: "boar", amount: -2}],
         line: "He followed the boar's tracks"},
        {id: "note", label: "Read them and go on", ap: 0, hp: 0, items: [], effects: [{kind: "observe", mob: "boar", amount: 1}],
         line: "He read the boar's tracks"}
     ]},

    {id: "quarry.cart", trigger: "gather", weight: 1, once: true,
     title: "A broken cart",
     text: "A quarryman's cart lies on its side, its load of dressed stone spilled across the road. No one has come back for it.",
     options: [
        {id: "load", label: "Carry what he can", ap: 2, hp: -4, items: [{id: "stone", amount: 6}], effects: [],
         line: "Dressed stone from the broken cart"},
        {id: "pass", label: "Leave it", ap: 0, hp: 0, items: [], effects: [],
         line: "He left the cart where it lay"}
     ]}
]

// What a fight offers besides Strike and Guard. `power` and `hit` are against a strike's
// (percent of its blow, points of its chance); `cool` is the turns before it can be used again;
// `all` strikes every beast standing; `asks` is the stat that opens it.
var walkTechniques = [
    {id: "heavy", name: "Heavy cut", breath: 2, cool: 2, power: 170, hit: -15, all: false,
     asks: {stat: "str", needed: 8}, line: "A slow, full blow"},
    {id: "feint", name: "Feint and step", breath: 1, cool: 1, power: 80, hit: 20, all: false,
     asks: {stat: "dex", needed: 8}, line: "A sure blow, and he is hard to bite after it"},
    {id: "sweep", name: "Sweep", breath: 3, cool: 3, power: 70, hit: 0, all: true,
     asks: {stat: "arms", needed: 1}, line: "One blow at every beast standing"}
]

// `deals` and `takes` are percent of what he deals and of what he takes.
var walkStances = [
    {id: "balanced", name: "Balanced", deals: 100, takes: 100, line: "Neither more nor less"},
    {id: "aggressive", name: "Aggressive", deals: 125, takes: 125, line: "He hits harder and is hit harder"},
    {id: "cautious", name: "Cautious", deals: 80, takes: 70, line: "He hits less hard and is hit less"}
]
