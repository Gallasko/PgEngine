// Chronicle rules: the town, as its page shows it
// -----------------------------------------------
// Input:  `age` (years), `character` (a table of stats and flags, with the town in it:
//         "town_known", "town.<place id>" its level, "fund.<place id>" the coin left to it,
//         "seen.<place id>" 1 once a life has had it on its page),
//         `done` (activity id -> the terms completed in this life) and `lives` (the lives of
//         the world, this one counted): what brings a place onto the page may be either.
//         `world` (handed as to every script; not read here).
// Output: `places`, one table per place of towntable.pg, in its order:
//           {id, name, glyph, about, level, most (the most its level can be),
//            shown   whether it is on the Town page for him: lib.pg's `placeShown`. The page
//                    grows with what he does; a place once shown stays shown
//            gives   "" at level 0, else what its level gives, in one line
//            given [{level, built, gives}]: every level reached, the first first. A level
//                    adds to the ones before it: the gloss lists them all, the tile says the last
//            tiers [{level, built, gives, reached}]: every level the place has, reached or not, the
//                    first first: the gloss lists them all, what he has raised and what is still to raise
//            line    what its tile says: that, or "NOT YET BUILT"
//            tale    "" or the line the log writes when its level is reached (the level's `lore`)
//            built   "" or what stands there at its level, as the log names it
//            fund    the coin left to it, counted toward its next level
//            nextWork   "" at its last level, else the id of the activity that raises it
//                       (activitytable.pg makes it from the same table: "raise.<id>.<level>")
//            nextName, nextMonths, nextCoin (less the fund, never below 0), nextYears,
//            nextCosts  what the next level asks, in one line: "6 mo · 20 coin · 1 Strength"
//            nextGives  what it will give
//            nextLocked true while he cannot pay for it
//            gaps [{stat, label, current, needed}]: what it takes from him, against what he has
//            leaves [{stat, amount}], leaveLine ("12 firewood, 4 ash wood"): what he holds of what
//                    walks bring for the town that the next level still asks, left to the place
//                    with his coin if it is the one he chooses at his death ("fund.<id>.<thing>"
//                    in `character`, counted toward what the level asks as the coin is)}
//         `start`, [{stat, amount}]: what a new life is born with for the town as it stands
//         (the `start` of every level reached). The Life screen adds them to a life that is not
//         the first of its world.
//         `opened`, the line the log and a toast say the month a life comes to know the town.
//         `raisedLine`, what follows a level's `built` in the line the log writes for it.
//         `epitaphLine`, "" or what a new life's log says before how the last one ended: the
//         inn tells it from its second level.
//         `fundLine`, what the gloss of a place writes before the coin left to it.
//         `foundLine`, what follows a place's name in the line said the month it comes onto the page.
//         `gift`, the gift a life may make at its death: {stat (what of his is left to a place:
//         it joins the place's fund), before and after (the ending's line around the amount),
//         plain and chosen (what the ending's button says without a gift, and with one), things (the
//         ending's line when he holds no coin, only things a place can use)}.
//         (`none` is a word of the language, and cannot name a field.)
//
// No function here: lib.pg holds them all, ahead of every table (see there why).

import "string"
import "math"
import "algorithm"
import "lib"
import "towntable"
import "expeditiontable"

var errors = []


var opened = "He has been to the market: the Town page is open"
var raisedLine = " stands in Bellmoor: the town will keep it"
var fundLine = "Left to it by those before him"
var foundLine = " is his to raise now: it has come onto the Town page"
var epitaphLine = ""
var gift = {stat: "coin", before: "LEAVE HIS ", after: " COIN TO", things: "LEAVE WHAT A PLACE CAN USE TO", plain: "Begin a new life", chosen: "Leave it, and begin a new life"}

if (statOf(character, "town.inn") >= 2)
{
    epitaphLine = "At the inn they still tell of the one before him. "
}

var places = []
var start = []

for (var t = 0; t < len(townPlaces); t++)
{
    var place = townPlaces[t]
    var most = len(place.levels)
    var level = clamp(statOf(character, "town." + place.id), 0, most)
    var fund = statOf(character, "fund." + place.id)

    var shown = {id: place.id, name: place.name, glyph: place.glyph, about: place.about, level: level, most: most,
                 shown: placeShown(place, character, monthOf(age), done, lives),
                 gives: "", line: "NOT YET BUILT", tale: "", built: "", fund: fund,
                 nextWork: "", nextName: "", nextMonths: 0, nextCoin: 0, nextYears: 0, nextCosts: "", nextGives: "", nextLocked: false,
                 gaps: [], given: [], tiers: [], leaves: [], leaveLine: ""}

    // What it gives is what every level reached gives: none takes the place of the one before
    for (var l = 0; l < level; l++)
    {
        push(shown.given, {level: l + 1, built: place.levels[l].built, gives: place.levels[l].gives})
    }

    // And every level it has, the ones still to raise with them
    for (var l = 0; l < most; l++)
    {
        push(shown.tiers, {level: l + 1, built: place.levels[l].built, gives: place.levels[l].gives, reached: l < level})
    }

    if (level > 0)
    {
        var reached = place.levels[level - 1]

        shown.gives = reached.gives
        shown.line = toUpperCase(reached.gives)
        shown.tale = reached.lore
        shown.built = reached.built
    }

    // What a new life is born with: every level reached, not the last alone
    for (var l = 0; l < level; l++)
    {
        var given = listOf(place.levels[l], "start")

        for (var g = 0; g < len(given); g++)
        {
            push(start, {stat: given[g].stat, amount: given[g].amount})
        }
    }

    if (level < most)
    {
        var next = place.levels[level]
        var coin = clamp(levelCoin(next, character) - fund, 0, next.coin)
        var asks = ""

        shown.nextWork = "raise." + place.id + "." + toString(level + 1)
        shown.nextName = next.work
        shown.nextMonths = next.months
        shown.nextCoin = coin
        shown.nextYears = lookup(next, "years", 0)
        shown.nextGives = next.gives

        if (next.months > 0)
        {
            asks = fmtMonths(next.months)
        }

        if (shown.nextYears > 0)
        {
            if (asks != "")
            {
                asks = asks + " · "
            }

            asks = asks + toString(shown.nextYears) + " years of his life"
        }

        if (coin > 0)
        {
            if (asks != "")
            {
                asks = asks + " · "
            }

            asks = asks + toString(coin) + " coin"
            push(shown.gaps, {stat: "coin", label: statName("coin"), current: statOf(character, "coin"), needed: coin})

            if (statOf(character, "coin") < coin)
            {
                shown.nextLocked = true
            }
        }

        var also = listOf(next, "costs")

        for (var c = 0; c < len(also); c++)
        {
            // The most a stat can be goes with the stat: said once, under the stat's name
            var isCap = false

            for (var k : statCaps)
            {
                if (statCaps[k] == also[c].stat)
                {
                    isCap = true
                }
            }

            // What lives before him left the place of it counts toward what it asks, as their coin does
            var need = clamp(also[c].amount - statOf(character, "fund." + place.id + "." + also[c].stat), 0, also[c].amount)

            if (not isCap and need > 0)
            {
                asks = asks + " · " + toString(need) + " " + statName(also[c].stat)
                push(shown.gaps, {stat: also[c].stat, label: statName(also[c].stat), current: statOf(character, also[c].stat), needed: need})
            }

            if (statOf(character, also[c].stat) < need)
            {
                shown.nextLocked = true
            }

            // And what he holds of it would be left to the place at his death, no more than it
            // still asks: what a walk brings for the town (expeditiontable.pg's `town` things) is
            // lost with him otherwise
            for (var w = 0; w < len(walkItems); w++)
            {
                if (walkItems[w].kind == "town" and walkItems[w].id == also[c].stat)
                {
                    var given = clamp(statOf(character, also[c].stat), 0, need)

                    if (given > 0)
                    {
                        push(shown.leaves, {stat: also[c].stat, amount: given})

                        if (shown.leaveLine != "")
                        {
                            shown.leaveLine = shown.leaveLine + ", "
                        }

                        shown.leaveLine = shown.leaveLine + toString(given) + " " + toLowerCase(walkItems[w].name)
                    }
                }
            }
        }

        shown.nextCosts = asks
    }

    push(places, shown)
}
