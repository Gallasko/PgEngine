// Chronicle rules: the basic resources and the economy's knobs
// ------------------------------------------------------------
// Imported by resources.pg (what he holds shows in the ledger) and, later, by the works that
// gather and spend them. Never loaded itself.
// Input:  none.
// Output: `basicResources`, what he gathers by working the land and the town's yards:
//           [{id, name, one, glyph, about}]
//         `madeResources`, what is made of them, not gathered:
//           [{id, name, one, glyph, about}]
//         `scavengeRows`, the activity rows that gather the basics by hand (group "Scavenge")
//         `storeRows`, the activity rows that raise a limit for the life (group "Your stores")
//         `familiarKinds`, `slotGivers`: the creatures he can bind, and what gives him slots for them
//         `economyKnobs`, the numbers of the economy that belong to no one resource:
//           stashMost   the most of any one thing the stash can keep between lives
//           baseSlots   the stash slots a life has before the town gives it more
//         `one` is the thing said once ("a clay"), as the log names it.
//         The most he can hold of each is lib.pg's `statLimits`; a store raises it with the stat
//         "store.<id>" (lib.pg's `limitOf`).
//         Each is held as a stat of the same id and has its row in the ledger, in the group
//         RESOURCES (resources.pg). Berries, firewood, stone and clay are still found on a walk
//         (expeditiontable.pg's `walkItems`); this table is what makes them a resource.
//
// The numbers are placeholders for the game's balance: change them here, nothing in C++ moves.

const basicResources = [
    {id: "berries", name: "Berries", one: "berry", glyph: "trade",
     about: "Picked along the hedges. The market buys them, and a pot of them is a meal."},
    {id: "water", name: "Water", one: "water", glyph: "vitality", lot: 10, coin: 1, price: 2,
     about: "Drawn from the well and the stream. Every craft of the town is wet work."},
    {id: "firewood", name: "Firewood", one: "firewood", glyph: "work", lot: 5, coin: 1, price: 2,
     about: "Deadfall and cuttings, bundled and carried home. Fires and forges burn it."},
    {id: "stone", name: "Stone", one: "stone", glyph: "forge", lot: 3, coin: 1, price: 3,
     about: "Dressed blocks and field stones. The places of the town are built of it."},
    {id: "clay", name: "Clay", one: "clay", glyph: "work", lot: 4, coin: 1,
     about: "Dug out of the bank, heavy and wet. Bricks and pots are made of it."}
]

const madeResources = [
    {id: "gems", name: "Gems", one: "gem", glyph: "relic",
     about: "Cut and polished stones. Few are made, and the town's finest work asks for them."}
]

const economyKnobs = {
    stashMost: 100,
    baseSlots: 1
}

// What he gathers by hand, a month at a time: the work the town leaves to a child. Each is
// repeatable, and each counts a stat "scavenged" (a plain counter: it is held in no ledger row,
// and no tile, gloss or log line shows it: lib.pg's `hiddenStats`).
// activitytable.pg puts them after the last of the Work rows, and copies them first; the
// drying of berries comes right after them, in the same group.
const scavengeRows = [
    {id: "scavenge.berries", group: "Scavenge", name: "Pick Berries on the Hedge", glyph: "trade", months: 1, rank: "", each: "BERRIES", path: "",
     fromAge: 7,
     gains: [{stat: "berries", amount: 6}, {stat: "scavenged"}],
     requires: []},
    {id: "scavenge.water", group: "Scavenge", name: "Draw Water from the Bell", glyph: "vitality", months: 1, rank: "", each: "WATER", path: "",
     fromAge: 7,
     gains: [{stat: "water", amount: 8}, {stat: "scavenged"}],
     requires: []},
    {id: "scavenge.firewood", group: "Scavenge", name: "Gather Deadfall", glyph: "work", months: 1, rank: "", each: "FIREWOOD", path: "",
     fromAge: 7,
     gains: [{stat: "firewood", amount: 4}, {stat: "scavenged"}],
     requires: []},
    {id: "scavenge.stone", group: "Scavenge", name: "Pick Stones from the Fields", glyph: "forge", months: 1, rank: "", each: "STONE", path: "",
     fromAge: 8,
     gains: [{stat: "stone", amount: 3}, {stat: "scavenged"}],
     requires: []}
]

// What raises the most he can hold of a basic, for this life: three terms of each, each term
// 20 more (the stat "store.<id>", a plain counter held in no ledger row; lib.pg's `limitOf`
// adds it to the base). activitytable.pg puts them after the Scavenge rows.
const storeRows = [
    {id: "store.berries", group: "Your stores", name: "Weave a Berry Basket", glyph: "trade", months: 2, rank: "", each: "BERRY LIMIT", path: "",
     fromAge: 8, uses: 3, onlyWith: "berries",
     gains: [{stat: "store.berries", amount: 20}],
     requires: [],
     costs: [{stat: "firewood", amount: 2}]},
    {id: "store.water", group: "Your stores", name: "Set a Rain Barrel", glyph: "vitality", months: 2, rank: "", each: "WATER LIMIT", path: "",
     fromAge: 8, uses: 3, onlyWith: "water",
     gains: [{stat: "store.water", amount: 20}],
     requires: [],
     costs: [{stat: "firewood", amount: 4}]},
    {id: "store.firewood", group: "Your stores", name: "Roof a Woodpile", glyph: "work", months: 2, rank: "", each: "FIREWOOD LIMIT", path: "",
     fromAge: 8, uses: 3, onlyWith: "firewood",
     gains: [{stat: "store.firewood", amount: 20}],
     requires: [],
     costs: [{stat: "firewood", amount: 3}, {stat: "stone", amount: 2}]},
    {id: "store.stone", group: "Your stores", name: "Clear a Stone Heap", glyph: "forge", months: 2, rank: "", each: "STONE LIMIT", path: "",
     fromAge: 8, uses: 3, onlyWith: "stone",
     gains: [{stat: "store.stone", amount: 20}],
     requires: [],
     costs: [{stat: "firewood", amount: 2}]}
]

// The creatures he can bind to himself, for life. Each eats and makes a thing a month (the
// month's own rules read `eats` and `makes`; binding asks `bind`), and each fills one slot.
// `known` kinds are his from the first; the others wait for the stat "know.fam.<id>", which
// research, the Old Shell and the Old Grey give. `one` is the kind said once ("a hedge sprite").
const familiarKinds = [
    {id: "sprite", name: "a hedge sprite", one: "sprite", glyph: "magic", known: true,
     about: "A small green thing that lives in the hedge. It keeps house for its berries, and asks a ration of him.",
     train: "Teach the Sprite the Old Brambles", eats: [{stat: "rations", amount: 1}], makes: [{stat: "berries", amount: 4}], bind: [{stat: "berries", amount: 6}]},
    {id: "imp", name: "a well imp", one: "imp", glyph: "vitality", known: false,
     about: "A wet, sullen thing out of the well. It will fetch water all month if it is fed and paid.",
     train: "Show the Imp the Deep Well",
     eats: [{stat: "rations", amount: 1}, {stat: "coin", amount: 1}], makes: [{stat: "water", amount: 8}], bind: [{stat: "water", amount: 8}]},
    {id: "brownie", name: "a kitchen brownie", one: "brownie", glyph: "work", known: false,
     about: "A hearth spirit. It turns a larder and a fire into rations, and takes its share.",
     train: "Teach the Brownie the Slow Oven",
     eats: [{stat: "berries", amount: 3}, {stat: "water", amount: 2}, {stat: "firewood", amount: 1}], makes: [{stat: "rations", amount: 2}], bind: [{stat: "firewood", amount: 4}]},
    {id: "mole", name: "a stone mole", one: "mole", glyph: "forge", known: false,
     about: "A blind digger, as heavy as a cat. The Old Shell knows how to call one.",
     train: "Teach the Mole the Deep Seam",
     eats: [{stat: "rations", amount: 2}], makes: [{stat: "stone", amount: 2}], bind: [{stat: "stone", amount: 4}]},
    {id: "weaver", name: "a gem weaver", one: "weaver", glyph: "relic", known: false,
     about: "A spider of the deep rock that spins stone into gems. The Old Grey keep the secret of it.",
     train: "Teach the Weaver the Fine Thread",
     eats: [{stat: "stone", amount: 3}, {stat: "water", amount: 3}, {stat: "rations", amount: 1}], makes: [{stat: "gems", amount: 1}], bind: [{stat: "stone", amount: 10}]}
]

// What gives him slots to bind familiars in: standing in the town (one each), a second calling
// (two each) and the Harrow relic (one). `needed` is the least of the stat that counts, 1 when
// left out.
const slotGivers = [
    {stat: "keep_oath", slots: 1},
    {stat: "collegium", slots: 1},
    {stat: "hidden_hand", slots: 1},
    {stat: "renegade", slots: 1},
    {stat: "castellan", slots: 2},
    {stat: "crusader", slots: 2},
    {stat: "curse_breaker", slots: 2},
    {stat: "spellwright", slots: 2},
    {stat: "assassin", slots: 2},
    {stat: "adventurer", slots: 2},
    {stat: "harrow_relic", slots: 1}
]
